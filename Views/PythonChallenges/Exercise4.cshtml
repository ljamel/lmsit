@{
    ViewData["Title"] = "Challenge Python 4 — Calculer la moyenne";
    ViewData["Description"] = "Challenge Python pratique : calculez la moyenne d'une liste de valeurs numériques. Exercice interactif INGENIUS pour apprendre les calculs numériques en Python.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/PythonChallenges/Exercise4";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "LearningResource",
      "name": "Challenge Python 4 — Calculer la moyenne",
      "description": "Exercice pratique Python : calculer la moyenne d'une liste. Maîtrisez sum() et len() en Python sur INGENIUS.",
      "url": "@(_baseUrl)/PythonChallenges/Exercise4",
      "inLanguage": "fr-FR",
      "educationalLevel": "Débutant",
      "teaches": ["Programmation Python", "Calcul de moyenne", "sum() et len()"],
      "provider": { "@@type": "Organization", "@@id": "@(_baseUrl)/#organization", "name": "INGENIUS" }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Accueil", "item": "@(_baseUrl)/" },
        { "@@type": "ListItem", "position": 2, "name": "Challenges Python", "item": "@(_baseUrl)/PythonChallenges/Exercise1" },
        { "@@type": "ListItem", "position": 3, "name": "Exercice 4 — Calculer la moyenne", "item": "@(_baseUrl)/PythonChallenges/Exercise4" }
      ]
    }
  ]
}
</script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0"><i class="fab fa-python"></i> Challenge Python 7 / 10</h2>
                </div>
                <div class="card-body">
                    <h4 class="mb-4">Calculer la moyenne</h4>
                    
                    <div class="alert alert-info">
                        <strong>Liste Python :</strong>
                        <pre class="mb-0 mt-2 no-copy">
[22,11,23,1,88,7,4,3,5]
                        </pre>
                        <small class="text-muted mt-2 d-block">
                            <strong>Objectif:</strong> Écrivez un script Python qui calcule et affiche la moyenne de cette liste.
                        </small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Output))
                    {
                        <div class="alert alert-secondary">
                            <strong>Résultat :</strong>
                            <pre class="mb-0 mt-2" style="color: #000; background-color: #f8f9fa; padding: 10px; border-radius: 5px;">@ViewBag.Output</pre>
                        </div>
                    }

                    <form method="post" asp-action="Exercise7">
                        <div class="form-group">
                            <label for="code"><strong>Votre code Python :</strong></label>
                            <textarea class="form-control no-copy" 
                                      id="code" 
                                      name="code" 
                                      placeholder="# Écrivez votre code Python ici&#10;# Indice: utilisez ne.evaluate('total / n') pour le calcul final"
                                      rows="8"
                                      required 
                                      autocomplete="off"
                                      spellcheck="false"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-play"></i> Exécuter le code
                        </button>
                    </form>

                    <div class="mt-3">
                        <span class="badge badge-success">Challenge 1 ✓</span>
                        <span class="badge badge-success">Challenge 2 ✓</span>
                        <span class="badge badge-success">Challenge 3 ✓</span>
                        <span class="badge badge-success">Challenge 4 ✓</span>
                        <span class="badge badge-success">Challenge 5 ✓</span>
                        <span class="badge badge-success">Challenge 6 ✓</span>
                        <span class="badge badge-info">Challenge 7 de 10</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .no-copy {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
