@{
    ViewData["Title"] = "Challenge Python 7 — Moyenne des notes par tranche d'âge";
    ViewData["Description"] = "Challenge Python avancé : calculez la moyenne des notes par tranche d'âge. Exercice interactif INGENIUS pour maîtriser le groupement et l'agrégation de données en Python.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/PythonChallenges/Exercise7";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "LearningResource",
      "name": "Challenge Python 7 — Moyenne des notes par tranche d'âge",
      "description": "Exercice avancé Python : grouper des données par âge et calculer leur moyenne. Maîtrisez les dictionnaires et l'agrégation sur INGENIUS.",
      "url": "@(_baseUrl)/PythonChallenges/Exercise7",
      "inLanguage": "fr-FR",
      "educationalLevel": "Intermédiaire",
      "teaches": ["Programmation Python", "Dictionnaires Python", "Groupement de données", "Agrégation"],
      "provider": { "@@type": "Organization", "@@id": "@(_baseUrl)/#organization", "name": "INGENIUS" }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Accueil", "item": "@(_baseUrl)/" },
        { "@@type": "ListItem", "position": 2, "name": "Challenges Python", "item": "@(_baseUrl)/PythonChallenges/Exercise1" },
        { "@@type": "ListItem", "position": 3, "name": "Exercice 7 — Moyenne par tranche d'âge", "item": "@(_baseUrl)/PythonChallenges/Exercise7" }
      ]
    }
  ]
}
</script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0"><i class="fab fa-python"></i> Challenge Python 10 / 10</h2>
                </div>
                <div class="card-body">
                    <h4 class="mb-4">Moyenne des notes par âge</h4>
                    
                    <div class="alert alert-info">
                        <strong>Dictionnaire Python :</strong>
                        <pre class="mb-0 mt-2 no-copy">
{
    'names': ['James', 'Bob', 'Mark', 'Kate', 'Sarah'],
    'notes': [17, 12, 14, 1, 13],
    'Ages': [21, 42, 84, 21, 42]
}
                        </pre>
                        <small class="text-muted mt-2 d-block">
                            <strong>Objectif:</strong> À partir de ce dictionnaire, créez un DataFrame, utilisez <strong>describe</strong> et affichez la moyenne des notes par âge.
                            <br />
                            <strong>Indice:</strong> Vous pouvez grouper par <code>Ages</code> et récupérer la colonne <code>mean</code> du <code>describe()</code>.
                        </small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Output))
                    {
                        <div class="alert alert-secondary">
                            <strong>Résultat :</strong>
                            <pre class="mb-0 mt-2" style="color: #000; background-color: #f8f9fa; padding: 10px; border-radius: 5px;">@ViewBag.Output</pre>
                        </div>
                    }

                    <form method="post" asp-action="Exercise10">
                        <div class="form-group">
                            <label for="code"><strong>Votre code Python :</strong></label>
                            <textarea class="form-control no-copy" 
                                      id="code" 
                                      name="code" 
                                      placeholder="# Écrivez votre code Python ici&#10;# indice :&#10;# module pandas &#10;# regrouper deux champs avec groupby puis faite la moyenne"
                                      rows="10"
                                      required 
                                      autocomplete="off"
                                      spellcheck="false"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-play"></i> Exécuter le code
                        </button>
                    </form>

                    <div class="mt-3">
                        <span class="badge badge-success">Challenge 1 ✓</span>
                        <span class="badge badge-success">Challenge 2 ✓</span>
                        <span class="badge badge-success">Challenge 3 ✓</span>
                        <span class="badge badge-success">Challenge 4 ✓</span>
                        <span class="badge badge-success">Challenge 5 ✓</span>
                        <span class="badge badge-success">Challenge 6 ✓</span>
                        <span class="badge badge-success">Challenge 7 ✓</span>
                        <span class="badge badge-success">Challenge 8 ✓</span>
                        <span class="badge badge-success">Challenge 9 ✓</span>
                        <span class="badge badge-info">Challenge 10 de 10</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .no-copy {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
