@{
    ViewData["Title"] = "Félicitations — Parcours Python INGENIUS complété !";
    ViewData["Description"] = "Félicitations ! Vous avez réussi les 10 challenges du parcours Python INGENIUS. Continuez votre progression en cybersécurité avec nos labs pratiques et tutoriels.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/PythonChallenges/Success";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "WebPage",
      "name": "Félicitations — Parcours Python INGENIUS complété !",
      "description": "Page de validation du parcours Python INGENIUS : 10 challenges Python réussis. Prochaine étape : les labs de cybersécurité pratique.",
      "url": "@(_baseUrl)/PythonChallenges/Success",
      "inLanguage": "fr-FR",
      "isPartOf": { "@@id": "@(_baseUrl)/#website" },
      "provider": { "@@type": "Organization", "@@id": "@(_baseUrl)/#organization", "name": "INGENIUS" }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Accueil", "item": "@(_baseUrl)/" },
        { "@@type": "ListItem", "position": 2, "name": "Challenges Python", "item": "@(_baseUrl)/PythonChallenges/Exercise1" },
        { "@@type": "ListItem", "position": 3, "name": "Parcours complété !", "item": "@(_baseUrl)/PythonChallenges/Success" }
      ]
    }
  ]
}
</script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-success">
                <div class="card-header bg-success text-white text-center">
                    <h1 class="mb-0"><i class="fas fa-trophy"></i> Félicitations !</h1>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fab fa-python text-success" style="font-size: 100px;"></i>
                    </div>
                    
                    <h3 class="mb-4">Vous avez réussi tous les challenges Python !</h3>
                    
                    <p class="lead">
                        Vous avez démontré votre maîtrise de la programmation Python en résolvant les 9 exercices :
                    </p>

                    <div class="alert alert-success text-left">
                        <ul class="list-unstyled mb-0">
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 1</strong> - Variables de base</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 2</strong> - Addition simple</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 3</strong> - Lire le deuxième élément d'une liste</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 4</strong> - Inverser une liste</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 5</strong> - Trier du plus grand au plus petit</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 6</strong> - Calculer la médiane</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 7</strong> - Calculer la moyenne</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 8</strong> - Supprimer les doublons</li>
                            <li><i class="fas fa-check text-success"></i> <strong>Challenge 9</strong> - Filtrer les valeurs supérieures à la moyenne</li>
                        </ul>
                    </div>

                    <div class="mt-4">
                        <h4 class="text-success">🎉 Score : 9/9 🎉</h4>
                    </div>

                    <hr class="my-4">

                    <div class="mt-4">
                        <a href="@Url.Action("Exercise1", "PythonChallenges")" class="btn btn-success btn-lg mr-2">
                            <i class="fas fa-redo"></i> Recommencer
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-home"></i> Retour à l'accueil
                        </a>
                    </div>

                    <div class="mt-4">
                        <small class="text-muted">
                            Continuez à pratiquer pour améliorer vos compétences en Python !
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        animation: fadeIn 0.5s ease-in;
    }
    
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .fab {
        animation: bounce 2s infinite;
    }
    
    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-20px);
        }
        60% {
            transform: translateY(-10px);
        }
    }
</style>
