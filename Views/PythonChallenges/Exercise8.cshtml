@{
    ViewData["Title"] = "Challenge Python 8 — Variables Python";
    ViewData["Description"] = "Challenge Python pratique : manipulez les variables de base en Python. Exercice introductif INGENIUS pour comprendre les types et l'affectation de variables Python.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/PythonChallenges/Exercise8";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "LearningResource",
      "name": "Challenge Python 8 — Variables Python",
      "description": "Exercice introductif Python : manipulation des variables, types de données et affectation. Parfait pour les débutants sur INGENIUS.",
      "url": "@(_baseUrl)/PythonChallenges/Exercise8",
      "inLanguage": "fr-FR",
      "educationalLevel": "Débutant",
      "teaches": ["Programmation Python", "Variables Python", "Types de données", "Affectation"],
      "provider": { "@@type": "Organization", "@@id": "@(_baseUrl)/#organization", "name": "INGENIUS" }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Accueil", "item": "@(_baseUrl)/" },
        { "@@type": "ListItem", "position": 2, "name": "Challenges Python", "item": "@(_baseUrl)/PythonChallenges/Exercise1" },
        { "@@type": "ListItem", "position": 3, "name": "Exercice 8 — Variables Python", "item": "@(_baseUrl)/PythonChallenges/Exercise8" }
      ]
    }
  ]
}
</script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0"><i class="fab fa-python"></i> Challenge Python 1 / 10</h2>
                </div>
                <div class="card-body">
                    <h4 class="mb-4">Variables de base</h4>
                    
                    <div class="alert alert-info">
                        <strong>Objectif :</strong>
                        <small class="text-muted mt-2 d-block">
                            Écrivez un script Python qui déclare une variable <code>prenom</code> avec la valeur <code>"Alice"</code> et affiche cette variable.
                        </small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Output))
                    {
                        <div class="alert alert-secondary">
                            <strong>Résultat :</strong>
                            <pre class="mb-0 mt-2" style="color: #000; background-color: #f8f9fa; padding: 10px; border-radius: 5px;">@ViewBag.Output</pre>
                        </div>
                    }

                    <form method="post" asp-action="Exercise1">
                        <div class="form-group">
                            <label for="code"><strong>Votre code Python :</strong></label>
                            <textarea class="form-control no-copy" 
                                      id="code" 
                                      name="code" 
                                      placeholder="# Écrivez votre code Python ici&#10;# Exemple:&#10;# prenom = &quot;Alice&quot;&#10;# print(prenom)"
                                      rows="8"
                                      required 
                                      autocomplete="off"
                                      spellcheck="false"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-play"></i> Exécuter le code
                        </button>
                    </form>

                    <div class="mt-3">
                        <span class="badge badge-info">Challenge 1 de 10</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .no-copy {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
