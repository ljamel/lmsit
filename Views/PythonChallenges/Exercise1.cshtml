@{
    ViewData["Title"] = "Challenge Python 1 — Inverser une liste";
    ViewData["Description"] = "Challenge Python pratique : écrivez un script qui inverse l'ordre d'une liste. Exercice interactif du parcours Python INGENIUS, idéal pour les débutants.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/PythonChallenges/Exercise1";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "LearningResource",
      "name": "Challenge Python 1 — Inverser une liste",
      "description": "Exercice pratique Python : inverser l'ordre d'une liste. Valider votre code directement en ligne sur INGENIUS.",
      "url": "@(_baseUrl)/PythonChallenges/Exercise1",
      "inLanguage": "fr-FR",
      "educationalLevel": "Débutant",
      "teaches": ["Programmation Python", "Manipulation de listes", "Méthodes Python"],
      "provider": { "@@type": "Organization", "@@id": "@(_baseUrl)/#organization", "name": "INGENIUS" }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Accueil", "item": "@(_baseUrl)/" },
        { "@@type": "ListItem", "position": 2, "name": "Challenges Python", "item": "@(_baseUrl)/PythonChallenges/Exercise1" },
        { "@@type": "ListItem", "position": 3, "name": "Exercice 1 — Inverser une liste", "item": "@(_baseUrl)/PythonChallenges/Exercise1" }
      ]
    }
  ]
}
</script>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow mb-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fab fa-python"></i> Parcours Python - Niveaux 01 à 10</h3>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0"><i class="fab fa-python"></i> Challenge Python 4 / 10</h2>
                </div>
                <div class="card-body">
                    <h4 class="mb-4">Inverser la liste</h4>
                    
                    <div class="alert alert-info">
                        <strong>Liste Python :</strong>
                        <pre class="mb-0 mt-2 no-copy">
[1,2,3,4,5,6,7]
                        </pre>
                        <small class="text-muted mt-2 d-block">
                            <strong>Objectif:</strong> Écrivez un script Python qui inverse l'ordre de cette liste et affiche le résultat.
                        </small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Output))
                    {
                        <div class="alert alert-secondary">
                            <strong>Résultat :</strong>
                            <pre class="mb-0 mt-2" style="color: #000; background-color: #f8f9fa; padding: 10px; border-radius: 5px;">@ViewBag.Output</pre>
                        </div>
                    }

                    <form method="post" asp-action="Exercise4">
                        <div class="form-group">
                            <label for="code"><strong>Votre code Python :</strong></label>
                            <textarea class="form-control no-copy" 
                                      id="code" 
                                      name="code" 
                                      placeholder="# Écrivez votre code Python ici&#10;# Exemple:&#10;# lst = [1,2,3,4,5,6,7]&#10;# print(lst[::-1])"
                                      rows="8"
                                      required 
                                      autocomplete="off"
                                      spellcheck="false"></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-play"></i> Exécuter le code
                        </button>
                    </form>

                    <div class="mt-3">
                        <span class="badge badge-success">Challenge 1 ✓</span>
                        <span class="badge badge-success">Challenge 2 ✓</span>
                        <span class="badge badge-success">Challenge 3 ✓</span>
                        <span class="badge badge-info">Challenge 4 de 10</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .no-copy {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
