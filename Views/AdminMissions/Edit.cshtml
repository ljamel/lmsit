@model CrudDemo.Models.Mission

@{
    ViewData["Title"] = "Modifier la Mission";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0"><i class="fas fa-pen me-2 text-warning"></i>Modifier la Mission</h2>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Retour
            </a>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedBy" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Titre de la mission <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" required maxlength="200" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5" required maxlength="2000"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="RewardAmount" class="form-label fw-semibold">Récompense (€) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="RewardAmount" class="form-control" type="number" step="0.01" min="0.01" max="50" required />
                            <span class="input-group-text">€</span>
                        </div>
                        <span asp-validation-for="RewardAmount" class="text-danger small"></span>
                        <div class="form-text text-warning small">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Modifier ce montant n'affecte pas les récompenses déjà accordées.
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="MaxCompletions" class="form-label fw-semibold">Max complétions</label>
                        <input asp-for="MaxCompletions" class="form-control" type="number" min="0" />
                        <div class="form-text">0 = pas de limite.</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="StartsAt" class="form-label fw-semibold">Disponible à partir du</label>
                        <input asp-for="StartsAt" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="EndsAt" class="form-label fw-semibold">Date limite</label>
                        <input asp-for="EndsAt" class="form-control" type="datetime-local" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="RequiresAdminValidation" class="form-check-input" type="checkbox" />
                            <label asp-for="RequiresAdminValidation" class="form-check-label fw-semibold">
                                Validation admin requise
                            </label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Mission active</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="fas fa-save me-1"></i>Enregistrer
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
