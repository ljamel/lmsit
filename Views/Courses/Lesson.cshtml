@model CrudDemo.Models.Lesson

@{
    ViewData["Title"] = "Leçon: " + Model.Title;
    var comments = ViewBag.Comments as List<CrudDemo.Models.Comment> ?? new List<CrudDemo.Models.Comment>();
    var courseId = ViewBag.CourseId as int? ?? Model.Module!.CourseId;
    var orientationRole = ViewBag.OrientationRole as string;
    var orientationDescription = ViewBag.OrientationDescription as string;
    var orientationCourse = ViewBag.OrientationCourse as string;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="mb-3 animated-section">
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Module!.CourseId">
                    <i class="fas fa-arrow-left"></i> Retour au cours
                </a>
            </div>

            <div class="card mb-4">
                <div>
                    <h1 class="animated-title mb-0">
                        <i class="fas fa-book-open"></i> @Model.Title
                    </h1>
                </div>
                <div class="card-body">
                    <p class="text-muted animated-description">
                        <i class="fas fa-layer-group"></i> Module: <strong>@Model.Module.Title</strong>
                    </p>
                    <p class="animated-description">@Html.Raw(System.Net.WebUtility.HtmlDecode(Model.Description))</p>
                </div>
            </div>



    @if (!string.IsNullOrWhiteSpace(orientationRole))
    {
        <div class="alert quiz-result-card shadow-sm p-0 mt-4" role="alert" id="resultjobs" aria-live="polite">
            <div class="quiz-result-header px-4 py-3 d-flex align-items-center gap-3">
                <div>
                    <p class="mb-1 text-muted">Résultat du quiz</p>
                    <h2 class="h4 mb-0">Orientation recommandée : @orientationRole</h2>
                </div>
            </div>

            <div class="px-4 py-3">
                <p class="mb-3">@orientationDescription</p>
                <p class="mb-1 fw-semibold">@orientationCourse</p>

            </div>
        </div>
    }
            
              <!-- Section Commentaires du cours -->
    <div class="col-lg-12 mt-4">
        <div class="card shadow-sm">
            <div>
                <h4 class="mb-0">
                    <i class="fas fa-comments"></i> Commentaires du cours (@comments.Count)
                </h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Formulaire d'ajout de commentaire -->
                <form asp-action="AddComment" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@courseId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-edit"></i> Ajouter un commentaire sur ce cours
                        </label>
                        <textarea name="content" 
                                  class="form-control" 
                                  rows="3"
                                  placeholder="Partagez votre avis..." 
                                  maxlength="1000"
                                  required></textarea>
                        <small class="text-muted">Maximum 1000 caractères</small>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-paper-plane"></i> Publier
                    </button>
                </form>

                <hr>

                <!-- Liste des commentaires -->
                @if (comments.Any())
                {
                    <h5 class="mb-3">Commentaires</h5>
                    <div class="comments-list" style="max-height: 500px; overflow-y: auto;">
                        @foreach (var comment in comments)
                        {
                            <div class="comment-item p-3 mb-3 border rounded bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="mb-2">
                                            <strong class="text-primary">
                                                <i class="fas fa-user-circle"></i> @comment.UserId.Split('@')[0]
                                            </strong>
                                            <small class="text-muted ms-2">
                                                <i class="far fa-clock"></i> @comment.CreatedAt.ToString("dd/MM/yyyy à HH:mm")
                                            </small>
                                        </div>
                                        <p class="mb-0">@comment.Content</p>
                                    </div>
                                    @if (comment.UserId == User.Identity?.Name || User.IsInRole("Admin"))
                                    {
                                        <form asp-action="DeleteComment" method="post" class="ms-3">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Supprimer ce commentaire?')">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Aucun commentaire pour ce cours. Soyez le premier!
                    </div>
                }
            </div>
        </div>
    </div>

        </div>

@section Scripts {
    <script>
        (() => {
            const hasResult = @(string.IsNullOrWhiteSpace(orientationRole) ? "false" : "true");
            if (!hasResult) {
                return;
            }

            const result = document.getElementById('resultjobs');
            if (result) {
                result.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            const wrapper = document.createElement('div');
            wrapper.className = 'confetti-wrapper';
            document.body.appendChild(wrapper);

            const palette = ['bg-primary', 'bg-success', 'bg-warning', 'bg-danger', 'bg-info'];
            const total = 120;

            for (let index = 0; index < total; index++) {
                const piece = document.createElement('span');
                const colorClass = palette[index % palette.length];
                piece.className = `confetti-piece ${colorClass}`;
                piece.style.left = `${Math.random() * 100}vw`;
                piece.style.animationDuration = `${2.2 + Math.random() * 1.8}s`;
                piece.style.animationDelay = `${Math.random() * 0.45}s`;
                piece.style.transform = `rotate(${Math.random() * 360}deg)`;
                wrapper.appendChild(piece);
            }

            window.setTimeout(() => {
                wrapper.remove();
            }, 4200);
        })();

        (() => {
            const courseId = @courseId;
            const lessonId = @Model.Id;
            const trackingDelayMs = 4 * 60 * 1000;
            const retryDelayMs = 30 * 1000;
            const storageStartKey = `lesson_engagement_start_${lessonId}`;
            const storageTrackedKey = `lesson_engagement_tracked_${lessonId}`;
            let hasTracked = false;

            const trackEngagement = async () => {
                if (hasTracked || !Number.isInteger(courseId) || courseId <= 0 || !Number.isInteger(lessonId) || lessonId <= 0) {
                    return;
                }

                try {
                    const postResponse = await fetch('/Courses/TrackCourseEngagement', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ courseId, lessonId })
                    });

                    let ok = postResponse.ok;
                    if (!ok) {
                        const getResponse = await fetch(`/Courses/TrackCourseEngagementGet?courseId=${courseId}&lessonId=${lessonId}`, {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        ok = getResponse.ok;
                    }

                    if (ok) {
                        hasTracked = true;
                        localStorage.setItem(storageTrackedKey, '1');
                        localStorage.removeItem(storageStartKey);
                        return;
                    }
                } catch {
                }

                window.setTimeout(trackEngagement, retryDelayMs);
            };

            if (localStorage.getItem(storageTrackedKey) === '1') {
                hasTracked = true;
                return;
            }

            const now = Date.now();
            const startRaw = localStorage.getItem(storageStartKey);
            const startTs = startRaw ? Number(startRaw) : NaN;
            const effectiveStart = Number.isFinite(startTs) && startTs > 0 ? startTs : now;

            if (!Number.isFinite(startTs) || startTs <= 0) {
                localStorage.setItem(storageStartKey, String(now));
            }

            const elapsedMs = now - effectiveStart;
            const remainingMs = Math.max(0, trackingDelayMs - elapsedMs);
            window.setTimeout(trackEngagement, remainingMs);
        })();
    </script>
}



            @if (Model.Quizzes != null && Model.Quizzes.Any())
            {
                <div class="card">
                    <div class="card-header gradient-header-quiz">
                        <h5 class="mb-0">
                            <i class="fas fa-question-circle"></i> Quiz (@Model.Quizzes.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="SubmitLessonQuizAnswers" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lessonId" value="@Model.Id" />

                            @foreach (var quiz in Model.Quizzes)
                            {
                                <div class="mb-4 quiz-item animated-quiz-item">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h4 class="mb-1">
                                                <i class="fas fa-question"></i> @quiz.Question
                                            </h4>
                                            @if (!string.IsNullOrEmpty(quiz.Description))
                                            {
                                                <small class="text-muted d-block mb-2">@Html.Raw(@quiz.Description)</small>
                                            }
                                        </div>
                                        <span>
                                            <i class="fas fa-star"></i> @quiz.Points pts
                                        </span>
                                    </div>
                                    <div class="mt-3">
                                        @if (quiz.Options != null && quiz.Options.Any())
                                        {
                                            <div class="options-list">
                                                @{ var optionIndex = 0; }
                                                @foreach (var option in quiz.Options)
                                                {
                                                    <div class="form-check mb-3 animated-option-item">
                                                        <input class="form-check-input quiz-radio" type="radio"
                                                               name="answers[@quiz.Id]" id="option_@option.Id"
                                                               value="@option.Id" @(optionIndex == 0 ? "required" : string.Empty) />
                                                        <label class="form-check-label" for="option_@option.Id">
                                                            <span class="option-text">@option.Text</span>
                                                        </label>
                                                    </div>
                                                    optionIndex++;
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flag-answer-wrap mt-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" style="background:#16213e; border:1px solid #00B2FF; color:#00B2FF;">
                                                        <i class="fas fa-flag"></i>
                                                    </span>
                                                    <input type="text"
                                                           name="flagAnswers[@quiz.Id]"
                                                           class="form-control"
                                                           placeholder="Entrez votre réponse..."
                                                           style="background:#16213e; border:1px solid #00B2FF; color:#fff;"
                                                           required />
                                                </div>
                                                <small class="text-muted mt-1 d-block">
                                                    <i class="fas fa-info-circle me-1"></i>Saisissez votre réponse pour valider cette question
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="text-center mt-3">
                                <button type="submit" class="btn btn-success animated-btn px-4">
                                    <i class="fas fa-check-double"></i> Valider toutes mes réponses
                                </button>
                            </div>
                        </form>

                        <p class="text-center mt-4">
                            <a asp-action="QuizResults" asp-route-lessonId="@Model.Id" class="btn btn-info animated-btn">
                                <i class="fas fa-chart-bar"></i> Voir mes résultats
                            </a>
                        </p>
                    </div>
                </div>
            }
        </div>


    </div>

  


<style>
     /* quiz interacti par niveau */
    .section {
        display: none;
        margin-top: 20px;
        padding: 15px;
        border: 2px solid #333;
    }

    .animated-section {
        animation: slideDown 0.5s ease-out;
    }

    .animated-card {
        border: none;
        border-radius: 12px;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.320, 1);
        overflow: hidden;
        animation: slideUp 0.5s ease-out;
    }

    .animated-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .gradient-header-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

    .gradient-header-secondary {
        background: linear-gradient(135deg, #00d4ff 0%, #0099ff 100%);
        color: white;
        border: none;
    }

    .gradient-header-quiz {
        background: linear-gradient(135deg, #fa7e1e 0%, #ffa500 100%);
        color: white;
        border: none;
    }

    .gradient-header-progress {
        background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
        color: white;
        border: none;
    }

    .animated-title {
        animation: slideDown 0.6s ease-out 0.1s both;
    }

    .animated-description {
        animation: fadeIn 0.6s ease-out 0.2s both;
    }

    .video-wrapper {
        animation: scaleIn 0.5s ease-out;
    }

    .animated-video {
        border-radius: 8px;
        overflow: hidden;
    }

    .quiz-item {
        border: 2px solid #f0f0f0;
        border-radius: 8px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        animation: slideInLeft 0.4s ease-out;
    }

    .quiz-item:hover {
        border-color: #fa7e1e;
        background-color: #fffaf5;
        transform: translateX(5px);
    }

    .options-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .animated-option-item {
        animation: fadeIn 0.5s ease-out;
        padding: 0;
    }

    .quiz-radio {
        width: 1.3em;
        height: 1.3em;
        cursor: pointer;
        accent-color: #667eea;
        transition: all 0.3s ease;
    }

    .quiz-radio:checked {
        accent-color: #fa7e1e;
    }

    .option-text {
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .animated-quiz-item {
        animation: slideUp 0.5s ease-out;
    }

    .progress-item {
        animation: slideInLeft 0.5s ease-out;
        animation-fill-mode: both;
    }

    .progress-item:nth-child(1) { animation-delay: 0s; }
    .progress-item:nth-child(2) { animation-delay: 0.1s; }
    .progress-item:nth-child(3) { animation-delay: 0.2s; }

    .animated-tip {
        animation: fadeIn 0.6s ease-out 0.4s both;
    }

    .animated-btn {
        transition: all 0.3s ease;
    }

    .animated-btn:hover {
        transform: scale(1.05) translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .comment-item {
        transition: all 0.2s ease;
        border-left: 4px solid #0d6efd !important;
    }
    
    .comment-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transform: translateX(5px);
    }
    
    .comments-list::-webkit-scrollbar {
        width: 8px;
    }
    
    .comments-list::-webkit-scrollbar-track {
        background: #f1f1f1;
    }
    
    .comments-list::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }
    
    .comments-list::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>


<!-- quiz par iveau -->
<script>
(function () {

    const passwords = {
        "1": "Windows Server 2019 Datacenter",
        "2": "MsMpEng_1772_160.36",
        "3": "714C533967FE9EA1C8AB7A9B31CFA13F0C1CEEBCD4BF4D365F9AE8E95764B983"
    };

    function checkLevel(level) {
        const input = document.getElementById("input" + level);
        if (!input) return;

        // Supprime espaces et retours de ligne invisibles
        const value = input.value.replace(/^\s+|\s+$/g, "");

        if (value === passwords[level.toString()]) {
            if (level === 1) document.getElementById("section2").style.display = "block";
            else if (level === 2) document.getElementById("section3").style.display = "block";
            else if (level === 3) document.getElementById("finalSection").style.display = "block";
        } 
    }

    document.querySelectorAll("button[data-level]").forEach(button => {
        button.addEventListener("click", function () {
            const level = parseInt(this.getAttribute("data-level"), 10);
            checkLevel(level);
        });
    });

})();
</script>

