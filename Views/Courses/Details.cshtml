@model CrudDemo.Models.Course

@{
    ViewData["Title"] = "Détails du Cours";
    var comments = ViewBag.Comments as List<CrudDemo.Models.Comment> ?? new List<CrudDemo.Models.Comment>();
    var courseId = ViewBag.CourseId as int? ?? Model.Id;
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-action="Index"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h1>@Model.Title</h1>
                    <p>@Model.Description</p>
                </div>

            </div>
        </div>
    </div>

    <h3>Sous modules</h3>
    @if (Model.Modules == null || !Model.Modules.Any())
    {
        <div class="alert alert-info">
            <p>Aucun module dans ce cours pour le moment.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var module in Model.Modules.OrderBy(m => m.OrderIndex))
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@module.Title</h5>
                            @if (!string.IsNullOrEmpty(module.Description))
                            {
                                <p class="mb-2 text-muted">@module.Description</p>
                            }
                            
                            @if (module.Lessons != null && module.Lessons.Any())
                            {
                                <small><i class="fas fa-video"></i> @module.Lessons.Count leçon(s)</small>
                                <ul class="list-unstyled ms-3 mt-2">
                                    @foreach (var lesson in module.Lessons.OrderBy(l => l.OrderIndex))
                                    {
                                        <li class="mb-2">
                                            <a asp-action="Lesson" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-play-circle"></i> @lesson.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <small class="text-muted">Aucune leçon dans ce module.</small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

  
</div>

<style>
    .comment-item {
        transition: all 0.2s ease;
        border-left: 4px solid #0d6efd !important;
    }
    
    .comment-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transform: translateX(5px);
    }
</style>

@section Scripts {
    <script>
        (() => {
            const courseId = @courseId;
            const trackingDelayMs = 2 * 60 * 1000;
            const retryDelayMs = 30 * 1000;
            const storageStartKey = `course_engagement_start_${courseId}`;
            const storageTrackedKey = `course_engagement_tracked_${courseId}`;
            let hasTracked = false;

            const trackEngagement = async () => {
                if (hasTracked || !Number.isInteger(courseId) || courseId <= 0) {
                    return;
                }

                try {
                    const postResponse = await fetch('/Courses/TrackCourseEngagement', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ courseId })
                    });

                    let ok = postResponse.ok;
                    if (!ok) {
                        const getResponse = await fetch(`/Courses/TrackCourseEngagementGet?courseId=${courseId}`, {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        ok = getResponse.ok;
                    }

                    if (ok) {
                        hasTracked = true;
                        localStorage.setItem(storageTrackedKey, '1');
                        localStorage.removeItem(storageStartKey);
                        return;
                    }
                } catch {
                }

                window.setTimeout(trackEngagement, retryDelayMs);
            };

            if (localStorage.getItem(storageTrackedKey) === '1') {
                hasTracked = true;
                return;
            }

            const now = Date.now();
            const startRaw = localStorage.getItem(storageStartKey);
            const startTs = startRaw ? Number(startRaw) : NaN;
            const effectiveStart = Number.isFinite(startTs) && startTs > 0 ? startTs : now;

            if (!Number.isFinite(startTs) || startTs <= 0) {
                localStorage.setItem(storageStartKey, String(now));
            }

            const elapsedMs = now - effectiveStart;
            const remainingMs = Math.max(0, trackingDelayMs - elapsedMs);
            window.setTimeout(trackEngagement, remainingMs);
        })();
    </script>
}
