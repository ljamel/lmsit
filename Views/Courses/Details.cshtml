@model CrudDemo.Models.Course

@{
    ViewData["Title"] = "Détails du Cours";
    var comments = ViewBag.Comments as List<CrudDemo.Models.Comment> ?? new List<CrudDemo.Models.Comment>();
    var courseId = ViewBag.CourseId as int? ?? Model.Id;
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h1>@Model.Title</h1>
                    <p class="text-muted">Créé par: @Model.CreatedBy</p>
                    <p>@Model.Description</p>
                </div>

            </div>
        </div>
    </div>

    <h3>Modules</h3>
    @if (Model.Modules == null || !Model.Modules.Any())
    {
        <div class="alert alert-info">
            <p>Aucun module dans ce cours pour le moment.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var module in Model.Modules.OrderBy(m => m.OrderIndex))
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@module.Title</h5>
                            @if (!string.IsNullOrEmpty(module.Description))
                            {
                                <p class="mb-2 text-muted">@module.Description</p>
                            }
                            
                            @if (module.Lessons != null && module.Lessons.Any())
                            {
                                <small><i class="fas fa-video"></i> @module.Lessons.Count leçon(s)</small>
                                <ul class="list-unstyled ms-3 mt-2">
                                    @foreach (var lesson in module.Lessons.OrderBy(l => l.OrderIndex))
                                    {
                                        <li class="mb-2">
                                            <a asp-action="Lesson" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-play-circle"></i> @lesson.Title
                                            </a>
                                            @if (!string.IsNullOrEmpty(lesson.VideoFileName))
                                            {
                                                <small class="text-muted d-block">(@lesson.VideoFileName)</small>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <small class="text-muted">Aucune leçon dans ce module.</small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Section Commentaires -->
    <div class="card mt-4 shadow-sm">
        <div>
                <i class="fas fa-comments"></i> Commentaires (@comments.Count)
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Formulaire d'ajout de commentaire -->
            <form asp-action="AddComment" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@courseId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fas fa-edit"></i> Ajouter un commentaire
                    </label>
                    <textarea name="content" 
                              class="form-control" 
                              rows="3"
                              placeholder="Partagez votre avis sur ce cours..." 
                              maxlength="1000"
                              required></textarea>
                    <small class="text-muted">Maximum 1000 caractères</small>
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> Publier le commentaire
                </button>
            </form>

            <hr>

            <!-- Liste des commentaires -->
            @if (comments.Any())
            {
                <h5 class="mb-3">Tous les commentaires</h5>
                <div class="comments-list">
                    @foreach (var comment in comments)
                    {
                        <div class="comment-item p-3 mb-3 border rounded bg-light">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="mb-2">
                                        <strong class="text-primary">
                                            <i class="fas fa-user-circle"></i> @comment.UserId.Split('@')[0]
                                        </strong>
                                        <small class="text-muted ms-2">
                                            <i class="far fa-clock"></i> @comment.CreatedAt.ToString("dd/MM/yyyy à HH:mm")
                                        </small>
                                    </div>
                                    <p class="mb-0">@comment.Content</p>
                                </div>
                                @if (comment.UserId == User.Identity?.Name || User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteComment" method="post" class="ms-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <button type="submit" 
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Supprimer ce commentaire?')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Aucun commentaire pour le moment. Soyez le premier à commenter!
                </div>
            }
        </div>
    </div>
</div>

<style>
    .comment-item {
        transition: all 0.2s ease;
        border-left: 4px solid #0d6efd !important;
    }
    
    .comment-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transform: translateX(5px);
    }
</style>
