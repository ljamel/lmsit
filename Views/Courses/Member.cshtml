@model CrudDemo.Models.MemberProfileViewModel

@{
    ViewData["Title"] = "Espace Membre";
    var subscription = Model.Subscription;
    var isActiveSubscription = subscription?.IsActive == true && subscription.Status == "active";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0"><i class="fas fa-user-shield"></i> Espace Membre</h1>
            <span class="badge bg-primary">Profil</span>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Prix abonnement actuel</div>
                        <div class="fw-semibold">@Model.CurrentSubscriptionPriceEur.ToString("0.00") € / mois</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Statut abonnement</div>
                        <div class="fw-semibold">
                            @if (isActiveSubscription)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span>Inactif</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (subscription == null)
            {
                <div class="alert alert-warning mb-3" style="margin-bottom: 15px;">
                    Vous n'avez pas encore d'abonnement actif.
                </div>

                <a asp-controller="Payment" asp-action="SubscriptionCheckout" class="btn btn-primary">
                    <i class="fas fa-credit-card"></i> Souscrire un abonnement
                </a>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Date de début</div>
                            <div class="fw-semibold">@subscription.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Date d'annulation</div>
                            <div class="fw-semibold">
                                @(subscription.CanceledAt.HasValue ? subscription.CanceledAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                            </div>
                        </div>
                    </div>
                </div>

                @if (isActiveSubscription)
                {
                    <form asp-controller="Courses" asp-action="CancelSubscription" method="post" onsubmit="return confirm('Confirmer l\'annulation de votre abonnement ?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times-circle"></i> Annuler mon abonnement
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Payment" asp-action="SubscriptionCheckout" class="btn btn-primary">
                        <i class="fas fa-credit-card"></i> Réactiver un abonnement
                    </a>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0"><i class="fas fa-chart-bar"></i> Résultats Quiz</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Tentatives</div>
                        <div class="h4 mb-0">@Model.QuizAttempts</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Bonnes réponses</div>
                        <div class="h4 mb-0">@Model.QuizCorrectAnswers</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Taux de réussite</div>
                        <div class="h4 mb-0">@Model.QuizSuccessRate.ToString("0.0")%</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Dernier quiz</div>
                        <div class="fw-semibold">@(Model.LastQuizAttemptAt.HasValue ? Model.LastQuizAttemptAt.Value.ToString("dd/MM/yyyy") : "-")</div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                @if (Model.IsCertificateEligible)
                {
                    <div class="alert alert-success mb-2" style="margin-bottom: 15px;">
                        ✅ Tous les quiz sont complétés et votre score dépasse 80%.
                    </div>
                    <a asp-controller="Courses" asp-action="Certif1" class="btn btn-success">
                        <i class="fas fa-certificate"></i> Accéder à mon certificat
                    </a>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Certificat disponible quand tous les quiz sont complétés avec un score supérieur à 80%.<br />
                        Progression quiz: <strong>@Model.CompletedQuizCount / @Model.TotalQuizCount</strong> |
                        Points: <strong>@Model.EarnedQuizPoints / @Model.TotalQuizPoints</strong> |
                        Score: <strong>@Model.QuizSuccessRate.ToString("0.0")%</strong>
                    </div>
                }
            </div>
        </div>
    </div>

@{
    var allCourses = ViewBag.AllCourses as IEnumerable<CrudDemo.Models.Course> ?? Enumerable.Empty<CrudDemo.Models.Course>();
    var preferredCourseIds = ViewBag.PreferredCourseIds as HashSet<int> ?? new HashSet<int>();
}

    <div class="card shadow-sm mb-4" style="border:1px solid rgba(255,215,0,0.35);">
        <div class="card-header" style="background:linear-gradient(135deg,#1a1a00,#2a2200); border-bottom:1px solid rgba(255,215,0,0.25);">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0" style="color:#FFD700;">
                    <i class="fas fa-star me-2"></i>Mes domaines prioritaires
                </h2>
                <button type="button" onclick="openDomainPrefModal()"
                        style="background:linear-gradient(135deg,#FFD700,#b8860b); border:none; color:#1a1a00;
                               padding:6px 16px; border-radius:8px; cursor:pointer;
                               font-family:'Rajdhani',sans-serif; font-weight:700; font-size:.9rem;">
                    <i class="fas fa-pen me-1"></i>Modifier
                </button>
            </div>
        </div>
        <div class="card-body" style="background:#0d0d1a;">
            @if (preferredCourseIds.Any())
            {
                <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
                    @foreach (var c in allCourses.Where(c => preferredCourseIds.Contains(c.Id)))
                    {
                        <span style="background:rgba(255,215,0,0.12);border:1px solid #FFD700;color:#FFD700;
                                     padding:4px 14px;border-radius:20px;font-size:.9rem;font-weight:600;">
                            <i class="fas fa-book-open me-1"></i>@c.Title
                        </span>
                    }
                </div>
            }
            else
            {
                <p style="color:rgba(255,255,255,0.5);margin:0;font-style:italic;">
                    <i class="fas fa-info-circle me-1"></i>Aucun domaine prioritaire sélectionné.
                </p>
            }
        </div>
    </div>

    <!-- Modal modifier domaines -->
    <div id="domainPrefEditOverlay"
         style="display:none;position:fixed;inset:0;z-index:99990;background:rgba(0,0,0,0.82);
                align-items:center;justify-content:center;padding:1rem;">
        <div style="background:linear-gradient(135deg,#0d0d1a 0%,#16213e 100%);
                    border:2px solid #00B2FF;border-radius:16px;max-width:600px;width:100%;
                    max-height:90vh;overflow-y:auto;box-shadow:0 0 60px rgba(0,178,255,0.35);
                    font-family:'Rajdhani',sans-serif;padding:2rem;">

            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
                <h2 style="color:#00B2FF;font-family:'Orbitron',sans-serif;font-size:1.2rem;margin:0;">
                    <i class="fas fa-star me-2"></i>Mes domaines prioritaires
                </h2>
                <button type="button" onclick="closeDomainPrefModal()"
                        style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:1.3rem;cursor:pointer;">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <p style="color:rgba(255,255,255,0.65);margin-bottom:1.2rem;">
                Sélectionnez les domaines sur lesquels vous voulez vous concentrer. Ils seront mis en évidence dans toute la plateforme.
            </p>

            <form method="post" action="/Account/SaveDomainPreference">
                @Html.AntiForgeryToken()
                <div style="display:flex;flex-direction:column;gap:.65rem;margin-bottom:1.4rem;">
                    @foreach (var course in allCourses)
                    {
                        <label for="dp_edit_@course.Id"
                               style="display:flex;align-items:center;gap:1rem;
                                      background:rgba(0,178,255,0.06);border:1px solid rgba(0,178,255,0.25);
                                      border-radius:10px;padding:.8rem 1rem;cursor:pointer;transition:all .2s;"
                               class="domain-pref-edit-option @(preferredCourseIds.Contains(course.Id) ? "dp-checked" : "")">
                            <input type="checkbox"
                                   id="dp_edit_@course.Id"
                                   name="courseIds"
                                   value="@course.Id"
                                   @(preferredCourseIds.Contains(course.Id) ? "checked" : "")
                                   style="width:20px;height:20px;accent-color:#00B2FF;flex-shrink:0;" />
                            <div style="color:#fff;font-weight:700;">
                                <i class="fas fa-book-open me-2" style="color:#00B2FF;"></i>@course.Title
                            </div>
                        </label>
                    }
                </div>
                <div style="display:flex;gap:.75rem;justify-content:flex-end;flex-wrap:wrap;">
                    <button type="button" onclick="closeDomainPrefModal()"
                            style="background:transparent;border:1px solid rgba(255,255,255,0.25);color:rgba(255,255,255,0.6);
                                   padding:8px 20px;border-radius:8px;cursor:pointer;font-family:'Rajdhani',sans-serif;font-size:1rem;">
                        <i class="fas fa-times me-1"></i>Annuler
                    </button>
                    <button type="submit"
                            style="background:linear-gradient(135deg,#00B2FF,#0080FF);border:none;color:#fff;
                                   padding:8px 24px;border-radius:8px;cursor:pointer;font-family:'Rajdhani',sans-serif;
                                   font-size:1rem;font-weight:700;box-shadow:0 4px 16px rgba(0,178,255,0.35);">
                        <i class="fas fa-save me-1"></i>Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .domain-pref-edit-option:hover { border-color:#00B2FF !important; background:rgba(0,178,255,0.12) !important; }
        .dp-checked { border-color:#00B2FF !important; background:rgba(0,178,255,0.18) !important; box-shadow:0 0 0 2px rgba(0,178,255,0.3); }
    </style>
    <script>
        function openDomainPrefModal() {
            var el = document.getElementById('domainPrefEditOverlay');
            el.style.display = 'flex';
        }
        function closeDomainPrefModal() {
            document.getElementById('domainPrefEditOverlay').style.display = 'none';
        }
        document.getElementById('domainPrefEditOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeDomainPrefModal();
        });
        // Surligner dynamiquement les options cochées
        document.querySelectorAll('.domain-pref-edit-option input').forEach(function(cb) {
            cb.addEventListener('change', function() {
                var lbl = this.closest('label');
                if (this.checked) lbl.classList.add('dp-checked');
                else lbl.classList.remove('dp-checked');
            });
        });
    </script>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0"><i class="fas fa-compass"></i> Orientation Métier</h2>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.OrientationRole))
            {
                <p class="mb-2"><strong>Orientation :</strong> @Model.OrientationRole</p>
                @if (!string.IsNullOrWhiteSpace(Model.OrientationDescription))
                {
                    <p class="mb-2">@Model.OrientationDescription</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.OrientationCourse))
                {
                    <p class="mb-0"><strong>Parcours conseillé :</strong> @Model.OrientationCourse</p>
                }
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Aucun résultat d'orientation enregistré pour le moment.
                </div>
            }
        </div>
    </div>
</div>
