@model CrudDemo.Models.MemberProfileViewModel

@{
    ViewData["Title"] = "Espace Membre";
    var subscription = Model.Subscription;
    var isActiveSubscription = subscription?.IsActive == true && subscription.Status == "active";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0"><i class="fas fa-user-shield"></i> Espace Membre</h1>
            <span class="badge bg-primary">Profil</span>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Prix abonnement actuel</div>
                        <div class="fw-semibold">@Model.CurrentSubscriptionPriceEur.ToString("0.00") € / mois</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Statut abonnement</div>
                        <div class="fw-semibold">
                            @if (isActiveSubscription)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span>Inactif</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (subscription == null)
            {
                <div class="alert alert-warning mb-3" style="margin-bottom: 15px;">
                    Vous n'avez pas encore d'abonnement actif.
                </div>

                <a asp-controller="Payment" asp-action="SubscriptionCheckout" class="btn btn-primary">
                    <i class="fas fa-credit-card"></i> Souscrire un abonnement
                </a>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Date de début</div>
                            <div class="fw-semibold">@subscription.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Date d'annulation</div>
                            <div class="fw-semibold">
                                @(subscription.CanceledAt.HasValue ? subscription.CanceledAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                            </div>
                        </div>
                    </div>
                </div>

                @if (isActiveSubscription)
                {
                    <form asp-controller="Courses" asp-action="CancelSubscription" method="post" onsubmit="return confirm('Confirmer l\'annulation de votre abonnement ?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times-circle"></i> Annuler mon abonnement
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Payment" asp-action="SubscriptionCheckout" class="btn btn-primary">
                        <i class="fas fa-credit-card"></i> Réactiver un abonnement
                    </a>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0"><i class="fas fa-chart-bar"></i> Résultats Quiz</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Tentatives</div>
                        <div class="h4 mb-0">@Model.QuizAttempts</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Bonnes réponses</div>
                        <div class="h4 mb-0">@Model.QuizCorrectAnswers</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Taux de réussite</div>
                        <div class="h4 mb-0">@Model.QuizSuccessRate.ToString("0.0")%</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted small">Dernier quiz</div>
                        <div class="fw-semibold">@(Model.LastQuizAttemptAt.HasValue ? Model.LastQuizAttemptAt.Value.ToString("dd/MM/yyyy") : "-")</div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                @if (Model.IsCertificateEligible)
                {
                    <div class="alert alert-success mb-2" style="margin-bottom: 15px;">
                        ✅ Tous les quiz sont complétés et votre score dépasse 80%.
                    </div>
                    <a asp-controller="Courses" asp-action="Certif1" class="btn btn-success">
                        <i class="fas fa-certificate"></i> Accéder à mon certificat
                    </a>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Certificat disponible quand tous les quiz sont complétés avec un score supérieur à 80%.<br />
                        Progression quiz: <strong>@Model.CompletedQuizCount / @Model.TotalQuizCount</strong> |
                        Points: <strong>@Model.EarnedQuizPoints / @Model.TotalQuizPoints</strong> |
                        Score: <strong>@Model.QuizSuccessRate.ToString("0.0")%</strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0"><i class="fas fa-compass"></i> Orientation Métier</h2>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.OrientationRole))
            {
                <p class="mb-2"><strong>Orientation :</strong> @Model.OrientationRole</p>
                @if (!string.IsNullOrWhiteSpace(Model.OrientationDescription))
                {
                    <p class="mb-2">@Model.OrientationDescription</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.OrientationCourse))
                {
                    <p class="mb-0"><strong>Parcours conseillé :</strong> @Model.OrientationCourse</p>
                }
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Aucun résultat d'orientation enregistré pour le moment.
                </div>
            }
        </div>
    </div>
</div>
