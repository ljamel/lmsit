@model List<CrudDemo.Models.Course>

@{
    ViewData["Title"] = "Mes Cours";
    var comments = ViewBag.Comments as List<CrudDemo.Models.Comment> ?? new List<CrudDemo.Models.Comment>();
    var orientationRole = ViewBag.OrientationRole as string;
    var orientationDescription = ViewBag.OrientationDescription as string;
    var orientationCourse = ViewBag.OrientationCourse as string;
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="fas fa-graduation-cap"></i>Bienvenue. Choisissez un cours.
    </h1>
    

    <div style="text-align: justify;">
        <video controls="" width="350px" height="450px" style="float: left; margin: 0 0 15px 15px;"><source src="https://progfacil.fr/videos/bienvenue1.MOV"></video>
        <p data-start="55" data-end="287">Bienvenue dans la le&ccedil;on <strong data-start="79" data-end="110">&laquo; Introduction au Hacking &raquo;</strong>. Dans cette le&ccedil;on, nous allons explorer les bases du hacking, y compris ce qu&rsquo;est le hacking, les diff&eacute;rents types de hackers et les consid&eacute;rations &eacute;thiques li&eacute;es au hacking.</p>
        <br /><p data-start="289" data-end="797">Le hacking consiste en l&rsquo;acc&egrave;s ou le contr&ocirc;le non conventionnel de syst&egrave;mes informatiques ou de r&eacute;seaux. Il existe trois principaux types de hackers : les <strong data-start="439" data-end="460">hackers white hat</strong>, qui utilisent leurs comp&eacute;tences &agrave; des fins positives, les <strong data-start="520" data-end="541">hackers black hat</strong>, qui utilisent leurs comp&eacute;tences &agrave; des fins malveillantes, et les <strong data-start="608" data-end="628">hackers grey hat</strong>, qui se situent quelque part entre les deux. Il est important de comprendre les implications &eacute;thiques du hacking et d&rsquo;utiliser ses comp&eacute;tences de mani&egrave;re responsable.</p>
        <br /><p data-start="799" data-end="1199">En conclusion, le hacking est un sujet complexe et controvers&eacute; qui n&eacute;cessite une compr&eacute;hension approfondie de la technologie et de l&rsquo;&eacute;thique. En apprenant les diff&eacute;rents types de hackers et les consid&eacute;rations &eacute;thiques impliqu&eacute;es, vous pouvez prendre des d&eacute;cisions &eacute;clair&eacute;es sur la mani&egrave;re d&rsquo;utiliser vos comp&eacute;tences en hacking. N&rsquo;oubliez pas : avec un grand pouvoir vient une grande responsabilit&eacute;.</p>
    </div>
    <ul data-start="1201" data-end="1436">
        <li data-start="1201" data-end="1287">
            <p data-start="1203" data-end="1287">Le hacking implique un acc&egrave;s non autoris&eacute; &agrave; des syst&egrave;mes ou r&eacute;seaux informatiques.</p>
        </li>
        <li data-start="1288" data-end="1371">
            <p data-start="1290" data-end="1371">Il existe trois principaux types de hackers : white hat, black hat et grey hat.</p>
        </li>
        <li data-start="1372" data-end="1436">
            <p data-start="1374" data-end="1436">Comprendre les implications &eacute;thiques du hacking est crucial.</p>
        </li>
        <li data-start="1372" data-end="1436">
            <p data-start="1374" data-end="1436">Pour avancer et résoudre un problème, on avance va pas à pas.</p>
        </li>
    </ul>
    <p>A vous de choisir votre camp !</p>


<style>
    .orientation-quiz-card {
        border-radius: 1rem;
    }

    .quiz-question {
        border: 1px solid var(--bs-border-color);
        border-radius: .75rem;
        padding: 1rem;
        background-color: var(--bs-light-bg-subtle);
    }

    .quiz-option {
        display: flex;
        align-items: flex-start;
        gap: .5rem;
        margin-bottom: .5rem;
    }

    .quiz-option .form-check-input {
        margin-top: .25rem;
        flex-shrink: 0;
    }

    .quiz-result-card {
        border-radius: 1rem;
    }

    .form-check {
        text-align: center;
        padding: 14px;
        max-width: 173px;
    }

    .confetti-wrapper {
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 1055;
    }

    .confetti-piece {
        position: absolute;
        top: -20px;
        width: 10px;
        height: 16px;
        opacity: .9;
        animation-name: confetti-fall;
        animation-timing-function: ease-out;
        animation-fill-mode: forwards;
        transform: rotate(0deg);
    }

    @@keyframes confetti-fall {
        0% {
            transform: translateY(-20px) rotate(0deg);
            opacity: 1;
        }

        100% {
            transform: translateY(110vh) rotate(720deg);
            opacity: 0;
        }
    }
</style>
    <hr class="my-4" />

    <h2 class="mb-3" id="orientation1">Quiz d’orientation métier cyber</h2>
    <p class="text-muted">Répondez rapidement pour découvrir le métier cyber qui vous correspond le mieux.</p>

<style>
    /* Conteneur principal */
    .quiz-wrapper {
        max-width: 700px;
        margin: 2rem auto;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Style des blocs de questions */
    .question-group {
        background: #ffffff;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .question-title {
        font-size: 1.1rem;
        color: #2d3436;
        margin-bottom: 1.2rem;
        display: block;
    }

    /* Masquer le bouton radio d'origine */
    .option-input {
        display: none;
    }

    /* Transformer le label en bouton large */
    .option-label {
        display: block;
        padding: 1rem 1.2rem;
        margin-bottom: 0.8rem;
        background-color: #f8f9fa;
        border: 2px solid #f1f2f6;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        color: #4b4b4b;
    }

    .option-label:hover {
        background-color: #e9ecef;
        border-color: #dfe4ea;
    }

    /* Style quand l'option est cochée */
    .option-input:checked + .option-label {
        background-color: #e7f1ff;
        border-color: #0d6efd;
        color: #0d6efd;
        font-weight: 600;
    }

    /* Bouton de validation */
    .btn-submit {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: bold;
        border-radius: 10px;
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        border: none;
        color: white;
        transition: transform 0.2s ease;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    }
</style>

<div class="quiz-wrapper">
    <form asp-action="OrientationQuiz" method="post">
        @Html.AntiForgeryToken()

        <div class="question-group">
            <label class="question-title fw-bold">1) Qu’est-ce qui vous motive le plus ?</label>
            
            <input class="option-input" type="radio" name="q1" id="q1a" value="1" required>
            <label class="option-label" for="q1a">🔍 Trouver des failles techniques</label>

            <input class="option-input" type="radio" name="q1" id="q1b" value="2">
            <label class="option-label" for="q1b">🛡️ Détecter et stopper des attaques</label>

            <input class="option-input" type="radio" name="q1" id="q1c" value="3">
            <label class="option-label" for="q1c">🏢 Structurer la sécurité d’une entreprise</label>
        </div>

        <div class="question-group">
            <label class="question-title fw-bold">2) Quel type de missions vous attire ?</label>
            
            <input class="option-input" type="radio" name="q2" id="q2a" value="1" required>
            <label class="option-label" for="q2a">⚔️ Simulations d’attaque (pentest)</label>

            <input class="option-input" type="radio" name="q2" id="q2b" value="2">
            <label class="option-label" for="q2b">🚨 Surveillance SOC et réponse à incident</label>

            <input class="option-input" type="radio" name="q2" id="q2c" value="3">
            <label class="option-label" for="q2c">📋 Audit, conformité et gestion du risque</label>
        </div>

        <div class="question-group">
            <label class="question-title fw-bold">3) Dans un incident cyber, vous préférez :</label>
            
            <input class="option-input" type="radio" name="q3" id="q3a" value="1" required>
            <label class="option-label" for="q3a">🧪 Comprendre le vecteur d’attaque utilisé</label>

            <input class="option-input" type="radio" name="q3" id="q3b" value="2">
            <label class="option-label" for="q3b">🚑 Contenir, éradiquer et rétablir le service</label>

            <input class="option-input" type="radio" name="q3" id="q3c" value="3">
            <label class="option-label" for="q3c">📝 Formaliser un plan d’action et les contrôles</label>
        </div>

        <div class="question-group">
            <label class="question-title fw-bold">4) Votre point fort actuel :</label>
            
            <input class="option-input" type="radio" name="q4" id="q4a" value="1" required>
            <label class="option-label" for="q4a">💻 Technique offensive (réseau, web, scripts)</label>

            <input class="option-input" type="radio" name="q4" id="q4b" value="2">
            <label class="option-label" for="q4b">📊 Analyse de logs et investigation</label>

            <input class="option-input" type="radio" name="q4" id="q4c" value="3">
            <label class="option-label" for="q4c">📂 Organisation, procédures et normes</label>
        </div>

        <div class="question-group">
            <label class="question-title fw-bold">5) Votre objectif à 2 ans :</label>
            
            <input class="option-input" type="radio" name="q5" id="q5a" value="1" required>
            <label class="option-label" for="q5a">🎯 Mener des audits offensifs complets</label>

            <input class="option-input" type="radio" name="q5" id="q5b" value="2">
            <label class="option-label" for="q5b">🕵️ Devenir analyste SOC confirmé</label>

            <input class="option-input" type="radio" name="q5" id="q5c" value="3">
            <label class="option-label" for="q5c">📈 Piloter la gouvernance cyber d’une équipe</label>
        </div>

        <button type="submit" class="btn-submit shadow">
            VOIR MON ORIENTATION
        </button>
    </form>
</div>

    @if (!string.IsNullOrWhiteSpace(orientationRole))
    {
        <div class="alert alert-success" role="alert" id="resultjobs">
            <h4 class="alert-heading mb-2">Orientation recommandée : @orientationRole</h4>
            <p class="mb-1">@orientationDescription</p>
            <p class="mb-0"><strong>Parcours conseillé :</strong> @orientationCourse</p>
        </div>
    }

</div>