@using CrudDemo.Models
@model List<CyberFeedItem>

@{
    ViewData["Title"] = "Veille Cybersécurité";
    ViewData["Description"] = "Veille cybersécurité INGENIUS : dernières alertes CERT-FR, actualités ZATAZ, The Hacker News et analyses Decipher, résumées et centralisées.";
}

<section class="features" id="veille">
    <h2 class="section-title">@ViewData["Title"]</h2>
    <p class="section-subtitle">
        La veille cyber permet l'analyse des vulnérabilités et exploits adverses pour identifier des chemins d'attaque crédibles.
        Elle permet d'anticiper les techniques réellement utilisées par les attaquants et de reproduire des scénarios d'intrusion réalistes.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="feed-empty">
            <i class="fas fa-satellite-dish" style="font-size:3rem; color:rgba(0,178,255,0.3); margin-bottom:1rem;"></i>
            <p>Chargement des flux de veille...</p>
        </div>
    }
    else
    {
        <div class="feed-grid">
            @foreach (var item in Model)
            {
                <a href="@item.Link" target="_blank" rel="noopener noreferrer" class="feed-card">
                    <div class="feed-card-body">
                        <span class="feed-badge"><i class="fas fa-rss"></i> @item.Source</span>
                        <h3 class="feed-card-title">@item.Title</h3>
                        @if (!string.IsNullOrEmpty(item.Summary))
                        {
                            <p class="feed-card-summary">@item.Summary</p>
                        }
                        <div class="feed-card-footer">
                            <span class="feed-date"><i class="fas fa-calendar-alt"></i> @item.PublishedDate</span>
                            <span class="feed-read-link">
                                Lire <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<style>
.section-subtitle { text-align:center; color:rgba(255,255,255,0.6); font-size:1.05rem; max-width:820px; margin:0 auto 50px; line-height:1.7; }
.feed-empty { text-align:center; padding:80px 20px; color:rgba(255,255,255,0.4); }
.feed-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:30px; }
.feed-card {
    background:linear-gradient(135deg,rgba(15,15,35,0.9),rgba(25,25,45,0.8));
    border:1px solid rgba(0,178,255,0.3); border-radius:20px;
    overflow:hidden; position:relative;
    transition:all 0.4s cubic-bezier(0.4,0,0.2,1);
    display:flex; flex-direction:column;
    backdrop-filter:blur(10px);
    text-decoration:none;
}
.feed-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,#FF5E00,#00B2FF);
    transform:scaleX(0); transform-origin:left; transition:transform 0.4s ease;
}
.feed-card:hover { transform:translateY(-8px); border-color:rgba(255,94,0,0.5); box-shadow:0 20px 40px rgba(0,178,255,0.15),0 0 40px rgba(255,94,0,0.2); }
.feed-card:hover::before { transform:scaleX(1); }
.feed-card-body { padding:1.8rem; flex:1; display:flex; flex-direction:column; gap:0.75rem; }
.feed-badge {
    display:inline-flex; align-items:center; gap:6px; width:fit-content;
    padding:4px 14px; border-radius:20px;
    background:rgba(255,94,0,0.15); border:1px solid rgba(255,94,0,0.4);
    color:#FF5E00; font-size:0.8rem; font-weight:600; letter-spacing:1px; text-transform:uppercase;
}
.feed-card-title { font-family:'Orbitron',monospace; font-size:1.05rem; color:#fff; margin:0; line-height:1.4; }
.feed-card-summary { color:rgba(255,255,255,0.65); font-size:0.92rem; line-height:1.7; flex:1; margin:0; }
.feed-card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:0.5rem; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.07); }
.feed-date { color:rgba(255,255,255,0.4); font-size:0.82rem; }
.feed-date i { margin-right:5px; color:#FF5E00; }
.feed-read-link { color:#00B2FF; text-decoration:none; font-size:0.9rem; font-weight:600; font-family:'Rajdhani',sans-serif; letter-spacing:1px; transition:color 0.2s; }
.feed-card:hover .feed-read-link { color:#FF5E00; }
.feed-read-link i { margin-left:6px; transition:transform 0.2s; }
.feed-card:hover .feed-read-link i { transform:translateX(4px); }
</style>
