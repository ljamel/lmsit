<div id="exitLeadOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100">
    <div class="d-flex align-items-center justify-content-center h-100 p-3">
        <div class="exit-lead-modal">
            <div id="exitLeadConfetti" aria-hidden="true"></div>
            <div class="exit-lead-header">
                <div>
                    <span class="exit-lead-badge">Ressource offerte</span>
                    <h3 class="exit-lead-title">Avant de partir, récupérez votre guide cyber</h3>
                </div>
                <button type="button" id="closeExitLeadPopup" class="exit-lead-close" aria-label="Fermer">×</button>
            </div>

            <div class="exit-lead-body">
                <p class="exit-lead-text">J’offre une ressource concrète pour progresser rapidement en cybersécurité. Entrez votre email pour y accéder maintenant.</p>

                <form asp-controller="Home" asp-action="CaptureCyberResourceEmail" method="post" id="exitLeadForm" target="_blank">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="exitLeadEmail" class="form-label">Votre email</label>
                        <input id="exitLeadEmail" name="email" type="email" class="form-control" placeholder="exemple@email.com" required />
                    </div>

                    <div class="mb-3">
                        <label for="exitLeadCaptcha" class="form-label">2 + 3 = ?</label>
                        <input id="exitLeadCaptcha" name="captchaAnswer" type="text" class="form-control" inputmode="numeric" placeholder="Votre réponse" required />
                    </div>

                    <div id="exitLeadMessage" class="small mb-2"></div>

                    <div class="d-flex gap-2 justify-content-end exit-lead-actions">
                        <button type="submit" id="exitLeadSubmit" class="btn btn-primary">Recevoir la ressource</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    (function () {
        const popupKey = 'exitLeadPopupShown';
        const overlay = document.getElementById('exitLeadOverlay');
        const closeButton = document.getElementById('closeExitLeadPopup');
        const form = document.getElementById('exitLeadForm');
        const emailInput = document.getElementById('exitLeadEmail');
        const submitButton = document.getElementById('exitLeadSubmit');
        const messageBox = document.getElementById('exitLeadMessage');
        const confettiContainer = document.getElementById('exitLeadConfetti');
        const checkEmailUrl = '@Url.Action("CheckCyberResourceEmail", "Home")';
        const submitAjaxUrl = '@Url.Action("CaptureCyberResourceEmailAjax", "Home")';
        const submitButtonDefaultText = submitButton?.textContent || 'Recevoir la ressource';
        let isAlreadyRegistered = false;
        let isSubmitting = false;

        if (!overlay || sessionStorage.getItem(popupKey) === '1') {
            return;
        }

        let popupVisible = false;

        function showPopup() {
            if (popupVisible) {
                return;
            }
            popupVisible = true;
            sessionStorage.setItem(popupKey, '1');
            overlay.style.display = 'block';
            overlay.style.position = 'fixed';
            overlay.style.top = '50%';
            overlay.style.left = '50%';
            overlay.style.transform = 'translate(-50%, -50%)';
            overlay.classList.remove('d-none');
            document.body.style.overflow = 'hidden';
            if (emailInput) {
                emailInput.focus();
            }
        }

        function hidePopup() {
            overlay.style.display = 'none';
            overlay.classList.add('d-none');
            document.body.style.overflow = '';
        }

        document.addEventListener('mouseout', function (event) {
            if (event.relatedTarget === null && event.clientY <= 0) {
                showPopup();
            }
        });

        closeButton?.addEventListener('click', hidePopup);

        overlay.addEventListener('click', function (event) {
            if (event.target === overlay) {
                hidePopup();
            }
        });

        function setMessage(text, type) {
            if (!messageBox) {
                return;
            }

            messageBox.textContent = text || '';
            messageBox.classList.remove('text-danger', 'text-success', 'text-muted');

            if (type === 'error') {
                messageBox.classList.add('text-danger');
            } else if (type === 'success') {
                messageBox.classList.add('text-success');
            } else {
                messageBox.classList.add('text-muted');
            }
        }

        function setSubmitDisabled(disabled) {
            if (!submitButton) {
                return;
            }

            submitButton.disabled = !!disabled;
        }

        function refreshSubmitState() {
            setSubmitDisabled(isAlreadyRegistered || isSubmitting);
        }

        function setSubmitLoading(loading) {
            isSubmitting = !!loading;

            if (submitButton) {
                if (loading) {
                    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Envoi...';
                } else {
                    submitButton.textContent = submitButtonDefaultText;
                }
            }

            refreshSubmitState();
        }

        function launchConfetti() {
            if (!confettiContainer) {
                return;
            }

            confettiContainer.innerHTML = '';
            const palette = [
                'var(--bs-warning)',
                'var(--bs-info)',
                'var(--bs-success)',
                'var(--bs-primary)',
                'var(--bs-danger)'
            ];

            for (let i = 0; i < 34; i++) {
                const piece = document.createElement('span');
                piece.className = 'exit-confetti-piece';
                piece.style.left = `${Math.random() * 100}%`;
                piece.style.backgroundColor = palette[Math.floor(Math.random() * palette.length)];
                piece.style.animationDuration = `${900 + Math.random() * 800}ms`;
                piece.style.animationDelay = `${Math.random() * 180}ms`;
                piece.style.setProperty('--confetti-x', `${-120 + Math.random() * 240}px`);
                confettiContainer.appendChild(piece);
            }

            setTimeout(function () {
                confettiContainer.innerHTML = '';
            }, 2200);
        }

        let checkEmailTimeout;
        emailInput?.addEventListener('input', function () {
            const email = (emailInput.value || '').trim();
            isAlreadyRegistered = false;
            refreshSubmitState();

            if (checkEmailTimeout) {
                clearTimeout(checkEmailTimeout);
            }

            if (!email) {
                setMessage('', 'info');
                return;
            }

            checkEmailTimeout = setTimeout(async function () {
                try {
                    const response = await fetch(`${checkEmailUrl}?email=${encodeURIComponent(email)}`, {
                        method: 'GET',
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        return;
                    }

                    const data = await response.json();
                    if (data.exists) {
                        isAlreadyRegistered = true;
                        setMessage('Vous êtes déjà inscrit.', 'error');
                    } else {
                        isAlreadyRegistered = false;
                        setMessage('', 'info');
                    }

                    refreshSubmitState();
                } catch {
                }
            }, 350);
        });

        form?.addEventListener('submit', async function (event) {
            event.preventDefault();
            sessionStorage.setItem(popupKey, '1');

            if (!form) {
                return;
            }

            if (submitButton?.disabled) {
                setMessage('Vous êtes déjà inscrit. Vérifieer votre mail', 'error');
                return;
            }

            setSubmitLoading(true);

            try {
                const formData = new FormData(form);
                const params = new URLSearchParams();
                for (const [key, value] of formData.entries()) {
                    if (typeof value === 'string') {
                        params.append(key, value);
                    }
                }

                const response = await fetch(submitAjaxUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin',
                    body: params.toString()
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    setMessage(data.message || 'Une erreur est survenue. Veuillez réessayer.', 'error');
                    isAlreadyRegistered = !!data.alreadyRegistered;
                    setSubmitLoading(false);
                    return;
                }

                setMessage('Merci ! Votre inscription est bien enregistrée.', 'success');
                launchConfetti();
                setSubmitLoading(false);

                setTimeout(function () {
                    if (data.redirectUrl) {
                        window.open(data.redirectUrl, '_blank');
                    }
                    hidePopup();
                }, 1200);
            } catch {
                setMessage('Une erreur est survenue. Veuillez réessayer.', 'error');
                isAlreadyRegistered = false;
                setSubmitLoading(false);
            }
        });
    })();






