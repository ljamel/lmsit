@{
    ViewData["Title"] = "Formation Cybersécurité Pratique";
    ViewData["Description"] = "INGENIUS — Formez-vous en cybersécurité avec des labs pratiques, tutoriels guidés, challenges CTF et préparation aux certifications. Démarrez gratuitement.";
}

@if (TempData["Error"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    </div>
}

<!-- Hero Section -->
<section class="hero" id="home">
    <div class="hero-content">
        <div class="text-rotator">
            <div class="text-set active">
                <h1 class="glitch-text" data-text="DEVENEZ PRO CYBER">Forme-toi,&nbsp; certifie-toi,&nbsp; décroche&nbsp; le&nbsp; job.</h1>
                <p class="subtitle">40 labs pratiques guidés + vidéos de débriefing — apprenez en faisant, pas en regardant.</p>
            </div>
            <div class="text-set">
                <h1 class="glitch-text" data-text="DEBUTANT">100%&nbsp; débutant</h1>
                <p class="subtitle">Nos cours bien structurés offrent un chemin clair vers la montée en compétences.</p>
            </div>
            <div class="text-set">
                <h1 class="glitch-text" data-text="HACKING ÉTHIQUE">PLONGE&nbsp; DANS&nbsp; L'ACTION&nbsp; AVEC&nbsp; DES&nbsp; EXERCICES&nbsp; PRATIQUES</h1>
                <p class="subtitle">Une immersion dans les fondamentaux du hacking pour vous mettre dans la peau d'un hacker.</p>
            </div>
        </div>
    </div>
    <div class="cta-container">
        <a  asp-controller="Account" asp-action="Register" class="cta-button cta-primary">FORMATION - 19€/mois</a>
        <a href="#features" class="cta-button cta-secondary">En savoir plus</a>
    </div>
</section>

<!-- Features Section -->
<section class="features" id="features">
    <h2 class="section-title">Compétences enseignées - Parcours</h2>
    <div class="features-container">
        <div class="feature-tabs">
            <div class="tab-item active" data-tab="performance">
                <span>Module 1 — Introduction & fondamentaux</span>
            </div>
            <div class="tab-item" data-tab="security">
                <span>Module 2 — Environnement & outils </span>
            </div>
            <div class="tab-item" data-tab="network">
                <span> Module 3 — Reconnaissance & scanning </span>
            </div>
            <div class="tab-item" data-tab="analytics">
                <span>Module 4 — Exploitation de faille </span>
            </div>
            <div class="tab-item" data-tab="integration">
                <span>Module 5 — Préparation aux certifications</span>
            </div>
            <div class="tab-item" data-tab="python">
                <span>Module 6 — Programmation</span>
            </div>
        </div>

        <div class="feature-content">
            <div class="content-panel active" id="performance">
                <h3>Maîtrise des systèmes</h3>
                <p>Apprenez l’administration Windows & Linux : gestion réseau, services, sécurité et bonnes pratiques professionnelles.</p>
                <ul class="feature-list">
                    <li>Termes et techniques du hacking (glossaire, méthodologies)</li>
                    <li>Craquer des fichiers protégés par mot de passe et des sites web</li>
                    <li>Comprendre les failles (SQLi, XSS, RCE, CSRF, etc.)</li>
                    <li>Administration Linux & Windows</li>
                    <li>Virtualisation & Cloud</li>
                    <li>Gestion Active Directory</li>
                    <li>Analyse réseau avancée</li>
                </ul>
            </div>

            <div class="content-panel" id="security">
                <h3>Cybersécurité essentielle</h3>
                <p>Les bases indispensables pour hacker des infrastructures et détecter les attaques.</p>
                <ul class="feature-list">
                    <li>Chiffrement & authentification</li>
                    <li>Les outils indispensables (Nmap, Metasploit, Hydra, Burp, wfuzz, sqlmap…)</li>
                    <li>Scripting pour le développement de payload et l'automatisation</li>
                    <li>Gestion des vulnérabilités CVEs</li>
                </ul>
            </div>

            <div class="content-panel" id="network">
                <h3>Pentest & Hacking éthique</h3>
                <p>Apprenez les techniques utilisées par les testeurs d’intrusion professionnels.</p>
                <ul class="feature-list">
                    <li>Reconnaissance & scans</li>
                    <li>Exploitation de vulnérabilités</li>
                    <li>Privilege escalation</li>
                    <li>Rédaction de rapports pro</li>
                </ul>
            </div>

            <div class="content-panel" id="analytics">
                <h3>Analyse & Forensic</h3>
                <p>Devenez capable d’analyser un incident et de retracer les actions de l’attaquant.</p>
                <ul class="feature-list">
                    <li>Logs & SIEM</li>
                    <li>Analyse mémoire</li>
                    <li>OSINT avancé</li>
                    <li>Reverse engineering (base)</li>
                </ul>
            </div>

            <div class="content-panel" id="integration">
                <h3>Préparation Certifications</h3>
                <p>Accompagnement pour les plus importantes certifications cybersécurité.</p>
                <ul class="feature-list">
                    <li>Cisco</li>
                    <li>Security+</li>
                    <li>ISO 27001</li>
                    <li>+ Bonus : conseils carrière</li>
                </ul>
            </div>

            <div class="content-panel" id="python">
                <h3>Programmation et automatisation</h3>
                <p>Créer des scripts pour automatiser des tâches et des exercices interactifs.</p>
                <ul class="feature-list">
                    <li>Python</li>
                    <li>Bash</li>
                    <li>Modèles de scripts pour le pentest</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- For Who Section -->
<section class="about" id="for-who">
    <h2 class="section-title">Pour qui / Pas pour qui</h2>
    <div class="about-content">
        <div class="about-text">
            <h2>Cette formation n’est pas pour :</h2>
            <ul class="feature-list">
                <li>Ceux qui cherchent des résultats sans pratiquer</li>
                <li>Ceux qui veulent des solutions toutes faites</li>
                <li>Ceux qui ne veulent pas s’impliquer</li>
            </ul>
        </div>
        <div class="about-text">
            <h2>À l’issue du programme, vous serez capable de :</h2>
            <ul class="feature-list">
                <li>Identifier des vulnérabilités courantes</li>
                <li>Utiliser des outils de scan réseau</li>
                <li>Comprendre les bases du pentesting légal</li>
                <li>Rédiger un rapport simple d’analyse</li>
            </ul>
        </div>
    </div>
</section>

