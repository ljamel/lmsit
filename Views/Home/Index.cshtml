@{
    ViewData["Title"] = "Formation Cybersécurité Pratique";
    ViewData["Description"] = "INGENIUS — Formez-vous en cybersécurité avec des labs pratiques, tutoriels guidés, challenges CTF et préparation aux certifications. Démarrez gratuitement.";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/";
    ViewData["OgType"] = "website";
    var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section HeadExtras {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Course",
  "name": "Formation Cybersécurité Pratique — Hacking Éthique & Pentest",
  "description": "Formation en ligne en cybersécurité avec 40 labs pratiques guidés, tutoriels vidéo, challenges CTF mensuels et préparation aux certifications (Security+, Cisco, ISO 27001). Accessible aux débutants, animée par un expert.",
  "url": "@(_baseUrl)/",
  "image": "@(_baseUrl)/images/og-default.png",
  "inLanguage": "fr-FR",
  "provider": {
    "@@type": "Organization",
    "@@id": "@(_baseUrl)/#organization",
    "name": "INGENIUS"
  },
  "instructor": {
    "@@type": "Person",
    "name": "Jamal Lamri",
    "jobTitle": "Expert en cybersécurité et formateur",
    "knowsAbout": ["cybersécurité", "hacking éthique", "Linux", "pentest", "réseaux"],
    "url": "@(_baseUrl)/"
  },
  "hasCourseInstance": {
    "@@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT5H",
    "inLanguage": "fr-FR"
  },
  "offers": {
    "@@type": "Offer",
    "price": "1",
    "priceCurrency": "EUR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "@(_baseUrl)/Account/Register",
    "category": "Accès à vie"
  },
  "aggregateRating": {
    "@@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "900",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@@type": "Review",
      "author": { "@@type": "Person", "name": "Alexandre Bas" },
      "reviewRating": { "@@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Cette formation m'a permis de passer de débutant à un niveau professionnel. Les labs et exercices sont très réalistes ! La progression est fluide et j'ai pu rapidement mettre en pratique mes nouvelles compétences."
    },
    {
      "@@type": "Review",
      "author": { "@@type": "Person", "name": "Benjamin Bacle", "jobTitle": "Ingénieur DevSecOps chez Stancer" },
      "reviewRating": { "@@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Monsieur Lamri a su montrer que les connaissances pures se développent avec le temps et la régularité. Les cours étaient dynamiques, avec des TD vraiment intéressants et agréables à réaliser."
    },
    {
      "@@type": "Review",
      "author": { "@@type": "Person", "name": "Gaëlle Deschamps", "jobTitle": "Ingénieur d'études et de développement chez CGI" },
      "reviewRating": { "@@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Jamal a toujours pris le temps de répondre à nos questions et de reformuler ses explications. Il est très patient et très organisé ce qui permet de donner un bon rythme à la formation."
    }
  ],
  "educationalLevel": "Débutant à intermédiaire",
  "teaches": [
    "Hacking éthique",
    "Pentest",
    "Administration Linux et Windows",
    "Analyse réseau",
    "Exploitation de vulnérabilités",
    "Préparation certifications Security+, Cisco, ISO 27001",
    "Scripting Python et Bash",
    "OSINT",
    "CTF (Capture The Flag)"
  ],
  "numberOfCredits": 6,
  "timeRequired": "P6M"
}
</script>

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "Faut-il des connaissances préalables pour suivre la formation ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Non. La formation INGENIUS est conçue pour les débutants complets. Le parcours commence par les fondamentaux (systèmes, réseaux, vocabulaire) avant de progresser vers le pentest et le hacking éthique avancé."
      }
    },
    {
      "@@type": "Question",
      "name": "Combien coûte la formation en cybersécurité INGENIUS ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "La formation INGENIUS est accessible via un Tester la formation à 1 €, pour un accès à vie. Vous accédez immédiatement à l'intégralité des 40 labs pratiques, des tutoriels vidéo et des challenges CTF."
      }
    },
    {
      "@@type": "Question",
      "name": "Quelles certifications prépare la formation ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "INGENIUS prépare aux certifications Cisco, CompTIA Security+ et ISO 27001. Des conseils carrière et des bonus exclusifs sont également inclus pour aider les apprenants à se positionner sur le marché de l'emploi en cybersécurité."
      }
    },
    {
      "@@type": "Question",
      "name": "Qu'est-ce qu'un lab pratique dans la formation ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Un lab pratique est un exercice guidé réalisé sur un environnement simulé (machine virtuelle, réseau isolé, application web vulnérable). INGENIUS propose 40 labs couvrant le scanning réseau, l'exploitation de failles (SQLi, XSS, RCE), le privilege escalation et l'analyse forensic. Chaque lab est accompagné d'une vidéo de débriefing."
      }
    },
    {
      "@@type": "Question",
      "name": "Y a-t-il un accompagnement ou un suivi personnalisé ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Oui. Les abonnés bénéficient d'un accès à un groupe privé d'entraide, de visioconférences live mensuelles avec des professionnels, d'exercices pratiques hebdomadaires corrigés par un mentor, et, après un an de cursus validé, d'une lettre de recommandation pour faciliter la recherche d'emploi."
      }
    },
    {
      "@@type": "Question",
      "name": "Qu'est-ce que le hacking éthique ?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Le hacking éthique (ou pentest) consiste à tester la sécurité d'un système informatique avec l'autorisation de son propriétaire, dans le but d'identifier et corriger les vulnérabilités avant qu'un attaquant malveillant ne les exploite. INGENIUS forme à ces techniques dans un cadre légal et pédagogique."
      }
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "@(_baseUrl)/"
    }
  ]
}
</script>
}

@if (TempData["Error"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    </div>
}

<!-- Hero Section -->
<section class="hero" id="home">
    <div class="hero-content">
        <div class="text-rotator">
            <div class="text-set active">
                <h1 class="glitch-text" data-text="DEVENEZ PRO CYBER">Forme-toi,&nbsp; certifie-toi,&nbsp; décroche&nbsp; le&nbsp; job.</h1>
                <p class="subtitle">40 labs pratiques guidés + vidéos de débriefing — apprenez en faisant, pas en regardant.</p>
            </div>
            <div class="text-set">
                <h1 class="glitch-text" data-text="DEBUTANT">100%&nbsp; débutant</h1>
                <p class="subtitle">Nos cours bien structurés offrent un chemin clair vers la montée en compétences.</p>
            </div>
            <div class="text-set">
                <h1 class="glitch-text" data-text="HACKING ÉTHIQUE">PLONGE&nbsp; DANS&nbsp; L'ACTION&nbsp; AVEC&nbsp; DES&nbsp; EXERCICES&nbsp; PRATIQUES</h1>
                <p class="subtitle">Une immersion dans les fondamentaux du hacking pour vous mettre dans la peau d'un hacker.</p>
            </div>
        </div>
    </div>
    <div class="cta-container">
                        <a asp-controller="Account" asp-action="Register" class="cta-button cta-primary">Tester la formation à 1€</a>
        <a href="#features" class="cta-button cta-secondary">En savoir plus</a>
    </div>
</section>

<!-- Video Présentation Section -->
<section class="video-presentation" id="video-presentation">
    <div class="container">
        <h2 class="section-title">Découvrez la formation en vidéo</h2>
        <p class="section-subtitle">Regardez comment INGENIUS vous emmène de zéro à pro en cybersécurité.</p>
        <div class="video-wrapper">
            <video controls preload="metadata" poster="" aria-label="Vidéo de présentation INGENIUS">
                <source src="https://progfacil.fr/videos/accueilpresentation1.mp4" type="video/mp4">
                Votre navigateur ne supporte pas la lecture vidéo.
            </video>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features" id="features">
    <h2 class="section-title">Compétences enseignées - Parcours</h2>
    <div class="features-container">
        <div class="feature-tabs">
            <div class="tab-item active" data-tab="performance">
                <span>Module 1 — Introduction</span>
            </div>
            <div class="tab-item" data-tab="security">
                <span>Module 2 — Terme & Techniques </span>
            </div>
            <div class="tab-item" data-tab="network">
                <span> Module 3 — Reconnaissance </span>
            </div>
            <div class="tab-item" data-tab="analytics">
                <span>Module 4 — Annalyste SOC </span>
            </div>
            <div class="tab-item" data-tab="exploitation">
                <span>Module 5 — Exploitation </span>
            </div>
            <div class="tab-item" data-tab="integration">
                <span>Module 6 — Certifications</span>
            </div>
            <div class="tab-item" data-tab="python">
                <span>Module 7 — Programmation</span>
            </div>
        </div>

        <div class="feature-content">
            <div class="content-panel active" id="performance">
                <h3>Maîtrise des systèmes</h3>
                <p>Apprenez l’administration Windows & Linux : gestion réseau, services, sécurité et bonnes pratiques professionnelles.</p>
                <ul class="feature-list">
                    <li>Termes et techniques du hacking (glossaire, méthodologies)</li>
                    <li>Craquer des fichiers protégés par mot de passe et des sites web</li>
                    <li>Comprendre les failles (SQLi, XSS, RCE, CSRF, etc.)</li>
                    <li>Administration Linux & Windows</li>
                    <li>Virtualisation & Cloud</li>
                    <li>Gestion Active Directory</li>
                </ul>
            </div>

            <div class="content-panel" id="security">
                <h3>Cybersécurité essentielle</h3>
                <p>Les bases indispensables pour hacker des infrastructures et détecter les attaques.</p>
                <ul class="feature-list">
                    <li>Chiffrement & authentification</li>
                    <li>Les outils indispensables (Nmap, Metasploit, Hydra, Burp, wfuzz, sqlmap…)</li>
                    <li>Scripting pour le développement de payload et l'automatisation</li>
                    <li>Gestion des vulnérabilités CVEs</li>
                </ul>
            </div>

            <div class="content-panel" id="network">
                <h3>Reconnaissance & scanning</h3>
                <p>Apprenez les techniques utilisées par les testeurs d’intrusion professionnels.</p>
                <ul class="feature-list">
                    <li>Reconnaissance & scans nmap</li>
                    <li>Script nse</li>
                    <li>Collecte de données</li>
                    <li>Rédaction de rapports professionnels</li>
                </ul>
            </div>
            <div class="content-panel" id="exploitation">
                <h3>Exploitation de failles</h3>
                <p>Devenez capable d'exploiter des failles de sécurité.</p>
                <ul class="feature-list">
                    <li>metasploite</li>
                    <li>Utilisation de POC CVE</li>
                    <li>sqlmap</li>
                    <li>Burp suite</li>
                </ul>
            </div>
            <div class="content-panel" id="analytics">
                <h3>Analyse & Forensic</h3>
                <p>Devenez capable d’analyser un incident et de retracer les actions de l’attaquant.</p>
                <ul class="feature-list">
                    <li>Logs & SIEM</li>
                    <li>Analyse mémoire</li>
                    <li>Wireshark</li>
                    <li>Reverse engineering (base)</li>
                </ul>
            </div>

            <div class="content-panel" id="integration">
                <h3>Préparation Certifications</h3>
                <p>Accompagnement pour les plus importantes certifications cybersécurité.</p>
                <ul class="feature-list">
                    <li>Cisco</li>
                    <li>Security+</li>
                    <li>ISO 27001</li>
                    <li>+ Bonus : conseils carrière</li>
                </ul>
            </div>

            <div class="content-panel" id="python">
                <h3>Programmation et automatisation</h3>
                <p>Créer des scripts pour automatiser des tâches et des exercices interactifs.</p>
                <ul class="feature-list">
                    <li>Python</li>
                    <li>Bash</li>
                    <li>Modèles de scripts pour le pentest</li>
                </ul>
            </div>
        </div>
    </div>
</section>

