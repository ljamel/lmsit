<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @{
        var _pageTitle = ViewData["Title"]?.ToString();
        var _seoTitle = (string.IsNullOrEmpty(_pageTitle) || _pageTitle == "Home Page")
            ? "INGENIUS - Formation Cybersécurité"
            : _pageTitle + " | INGENIUS";
        var _seoDesc = ViewData["Description"]?.ToString()
            ?? "INGENIUS — Formez-vous en cybersécurité avec 40+ labs pratiques, tutoriels guidés et challenges CTF.";
        var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var _canonicalUrl = ViewData["CanonicalUrl"]?.ToString()
            ?? $"{_baseUrl}{Context.Request.Path}";
        var _ogImage = ViewData["OgImage"]?.ToString()
            ?? $"{_baseUrl}/images/og-default.png";
        var _ogType = ViewData["OgType"]?.ToString() ?? "website";
    }
    <title>@_seoTitle</title>
    <meta name="description" content="@_seoDesc">
    <link rel="canonical" href="@_canonicalUrl">
    <!-- Open Graph -->
    <meta property="og:type" content="@_ogType">
    <meta property="og:url" content="@_canonicalUrl">
    <meta property="og:title" content="@_seoTitle">
    <meta property="og:description" content="@_seoDesc">
    <meta property="og:image" content="@_ogImage">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@_seoTitle">
    <meta name="twitter:description" content="@_seoDesc">
    <meta name="twitter:image" content="@_ogImage">
    <!-- SEO + GEO essentiels -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="author" content="Jamal Lamri">
    <meta name="geo.region" content="FR-IDF">
    <meta name="geo.placename" content="Paris">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/Home/Sitemap">
    <!-- JSON-LD : Organisation + Site Web (toutes pages) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "Organization",
          "@@id": "@(_baseUrl)/#organization",
          "name": "INGENIUS",
          "url": "@(_baseUrl)",
          "logo": {
            "@@type": "ImageObject",
            "url": "@(_baseUrl)/images/og-default.png",
            "width": 1200,
            "height": 630
          },
          "foundingDate": "2024",
          "description": "INGENIUS est une plateforme française de formation en cybersécurité proposant des labs pratiques, tutoriels guidés, challenges CTF et préparation aux certifications.",
          "areaServed": "FR",
          "knowsAbout": ["cybersécurité", "hacking éthique", "pentest", "CTF", "certifications sécurité"],
          "contactPoint": {
            "@@type": "ContactPoint",
            "email": "lamri87-ingenius@yahoo.com",
            "contactType": "customer support",
            "availableLanguage": "French"
          }
        },
        {
          "@@type": "WebSite",
          "@@id": "@(_baseUrl)/#website",
          "url": "@(_baseUrl)",
          "name": "INGENIUS — Formation Cybersécurité Pratique",
          "description": "Formez-vous en cybersécurité avec 40+ labs pratiques, tutoriels guidés, challenges CTF et préparation aux certifications.",
          "publisher": { "@@id": "@(_baseUrl)/#organization" },
          "inLanguage": "fr-FR",
          "potentialAction": {
            "@@type": "SearchAction",
            "target": {
              "@@type": "EntryPoint",
              "urlTemplate": "@(_baseUrl)/Tutorials?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="/templatemo-electric-xtra.css?v=20260325" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @RenderSection("HeadExtras", required: false)
</head>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var currentUserName = User.Identity?.Name ?? string.Empty;
}
<body data-authenticated="@(isAuthenticated.ToString().ToLowerInvariant())" data-user="@currentUserName">
<!-- Animated Grid Background -->
<div class="grid-bg"></div>
<div class="gradient-overlay"></div>
<div class="scanlines"></div>

@{
    var impersonatingAdminId = Context.Request.Cookies["AdminImpersonating"];
}
@if (!string.IsNullOrEmpty(impersonatingAdminId))
{
    <div style="position:fixed; top:0; left:0; right:0; z-index:99999; background:linear-gradient(90deg,#ff9800,#f44336); color:#fff; text-align:center; padding:10px 16px; font-family:'Rajdhani',sans-serif; font-size:1rem; font-weight:600; display:flex; align-items:center; justify-content:center; gap:16px; box-shadow:0 2px 12px rgba(244,67,54,0.5);">
        <i class="fas fa-user-secret"></i>
        <span>Mode impersonation actif — vous naviguez en tant qu'un autre utilisateur</span>
        <a href="/AdminCourses/ReturnToAdmin" style="background:#fff; color:#f44336; padding:4px 14px; border-radius:20px; text-decoration:none; font-weight:700; font-size:0.9rem;">
            <i class="fas fa-undo me-1"></i>Retourner en mode Admin
        </a>
    </div>
    <div style="height:46px;"></div>
}

@* Modal de sélection du domaine (première connexion) *@
@if (User.Identity?.IsAuthenticated ?? false)
{
    @await Component.InvokeAsync("DomainPreference")
}

<!-- Animated Shapes -->
<div class="shapes-container">
    <div class="shape shape-circle"></div>
    <div class="shape shape-triangle"></div>
    <div class="shape shape-square"></div>
</div>

<!-- Floating Particles -->
<div id="particles"></div>

<!-- Navigation -->
<nav id="navbar">
    <div class="nav-container">
        <a href="/#home" class="logo-link">
            <svg class="logo-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#FF5E00;stop-opacity:1"/>
                        <stop offset="100%" style="stop-color:#00B2FF;stop-opacity:1"/>
                    </linearGradient>
                </defs>
                <polygon points="20,2 38,14 38,26 20,38 2,26 2,14" fill="none" stroke="url(#logoGradient)" stroke-width="2"/>
                <polygon points="20,8 32,16 32,24 20,32 8,24 8,16" fill="url(#logoGradient)" opacity="0.3"/>
                <circle cx="20" cy="20" r="3" fill="url(#logoGradient)"/>
            </svg>
            <span class="logo-text">INGENIUS</span>
        </a>
        
        <ul class="nav-links" id="navLinks">
            <li class="nav-item nav-dropdown">
                <a href="/Home/Outils" class="nav-link nav-dropdown-toggle">CyberLab</a>
                <ul class="nav-submenu">
                    <li>
                        <a href="/PythonChallenges/Exercise1" class="nav-submenu-link">Exercice (Python en ligne)</a>
                    </li>
                    <li class="submenu-separator"></li>
                    <li>
                        <a href="http://progfacil.fr:7681/" class="nav-submenu-link" target="_blank">BASH (bac à sable bash Linux)</a>
                    </li>
                    <li>
                        <a href="http://progfacil.fr:8080/" class="nav-submenu-link" target="_blank">Hack mon site web</a>
                    </li>
                    <li>
                        <a href="/Home/Orientation" class="nav-submenu-link">Quiz d'orientation en cybersécurité</a>
                    </li>
                </ul>
            </li>
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Actual" class="nav-link">Actualités</a>
            </li>
            @await Component.InvokeAsync("TutorialsNav")

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <li>
                    <a asp-area="" asp-controller="Courses" asp-action="Index">ESPACE_MEMBRE</a>
                </li>
            }
            @if ((User?.Identity?.IsAuthenticated ?? false) && (User?.IsInRole("Admin") ?? false))
            {
                <li>
                    <a asp-area="" asp-controller="AdminCourses" asp-action="Index">ADMINCOURS</a>
                </li>
                <li>
                    <a asp-area="" asp-controller="AdminMissions" asp-action="Index">MISSIONS</a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Tutorials" asp-action="AdminIndex">ADMIN TUTOS</a>
                </li>
            }

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <li class="nav-item">
                    <span class="nav-link text-dark">@User?.Identity?.Name</span>
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Déconnexion</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Connexion</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Inscription</a>
                </li>
            }

            <li>
                <a href="/#contact" class="nav-link">Contact</a>
            </li>

        </ul>
        <div class="menu-toggle" id="menuToggle">
            <span></span><span></span><span></span>
        </div>
    </div>
</nav>

@RenderBody()

<!-- Footer -->
<footer>
    <div class="footer-content">
        <div class="footer-links">
            <a asp-controller="Legal" asp-action="FAQ">FAQ</a>
            <a asp-controller="Legal" asp-action="TermsOfSale">Conditions générales de vente</a>
            <a asp-controller="Home" asp-action="Recruting">Recrutement</a>
        </div>
        <p class="copyright">© 2025 INGENIUS. Tous droits réservés.</p>
    </div>
</footer>

<style>
/* Tutorials dropdown nav */
.nav-dropdown { position: relative; }
.nav-dropdown-toggle { cursor: pointer; }
.nav-submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: rgba(10,10,20,0.97);
    border: 1px solid rgba(0,212,255,0.3);
    border-radius: 8px;
    padding: 8px 0;
    list-style: none;
    z-index: 1000;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
.nav-dropdown:hover .nav-submenu { display: block; }
.nav-submenu-link {
    display: block;
    padding: 8px 18px;
    color: #ccc;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
}
.nav-submenu-link:hover { background: rgba(0,212,255,0.1); color: #00d4ff; }
.submenu-separator { border-top: 1px solid rgba(0,212,255,0.15); margin: 4px 0; }
@@media (max-width: 768px) {
    .nav-submenu { position: static; border: none; background: rgba(0,212,255,0.05); box-shadow: none; }
    .nav-dropdown:hover .nav-submenu { display: block; }
}
</style>
<script src="/templatemo-electric-scripts.js" asp-append-version="true"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>