<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INGENIUS - Formation Cybersécurité</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="/templatemo-electric-xtra.css?v=@DateTime.Now.Ticks" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var currentUserName = User.Identity?.Name ?? string.Empty;
}
<body data-authenticated="@(isAuthenticated.ToString().ToLowerInvariant())" data-user="@currentUserName">
<!-- Animated Grid Background -->
<div class="grid-bg"></div>
<div class="gradient-overlay"></div>
<div class="scanlines"></div>

<!-- Animated Shapes -->
<div class="shapes-container">
    <div class="shape shape-circle"></div>
    <div class="shape shape-triangle"></div>
    <div class="shape shape-square"></div>
</div>

<!-- Floating Particles -->
<div id="particles"></div>

<!-- Navigation -->
<nav id="navbar">
    <div class="nav-container">
        <a href="/#home" class="logo-link">
            <svg class="logo-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#FF5E00;stop-opacity:1"/>
                        <stop offset="100%" style="stop-color:#00B2FF;stop-opacity:1"/>
                    </linearGradient>
                </defs>
                <polygon points="20,2 38,14 38,26 20,38 2,26 2,14" fill="none" stroke="url(#logoGradient)" stroke-width="2"/>
                <polygon points="20,8 32,16 32,24 20,32 8,24 8,16" fill="url(#logoGradient)" opacity="0.3"/>
                <circle cx="20" cy="20" r="3" fill="url(#logoGradient)"/>
            </svg>
            <span class="logo-text">INGENIUS</span>
        </a>
        
        <ul class="nav-links" id="navLinks">
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Outils" class="nav-link">CyberLab</a>
            </li>
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Actual" class="nav-link">Actualités</a>
            </li>
            @await Component.InvokeAsync("TutorialsNav")

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <li>
                    <a asp-area="" asp-controller="Courses" asp-action="Index">COURS</a>
                </li>
            }
            @if ((User?.Identity?.IsAuthenticated ?? false) && (User?.IsInRole("Admin") ?? false))
            {
                <li>
                    <a asp-area="" asp-controller="AdminCourses" asp-action="Index">ADMINCOURS</a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Tutorials" asp-action="AdminIndex">ADMIN TUTOS</a>
                </li>
            }

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <li class="nav-item">
                    <span class="nav-link text-dark">@User?.Identity?.Name</span>
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Déconnexion</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Connexion</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Inscription</a>
                </li>
            }

            <li>
                <a href="/#contact" class="nav-link">Contact</a>
            </li>

        </ul>
        <div class="menu-toggle" id="menuToggle">
            <a asp-controller="Account" asp-action="Register" class="cta-button cta-primary" >Inscription</a>
            <span></span><span></span><span></span>
        </div>
    </div>
</nav>

@RenderBody()

<!-- Footer -->
<footer>
    <div class="footer-content">
        <div class="footer-links">
            <a asp-controller="Legal" asp-action="FAQ">FAQ</a>
            <a asp-controller="Legal" asp-action="TermsOfSale">Conditions générales de vente</a>
            <a asp-controller="Home" asp-action="Recruting">Recrutement</a>
        </div>
        <p class="copyright">© 2025 INGENIUS. Tous droits réservés.</p>
    </div>
</footer>

<style>
/* Tutorials dropdown nav */
.nav-dropdown { position: relative; }
.nav-dropdown-toggle { cursor: pointer; }
.nav-submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: rgba(10,10,20,0.97);
    border: 1px solid rgba(0,212,255,0.3);
    border-radius: 8px;
    padding: 8px 0;
    list-style: none;
    z-index: 1000;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
.nav-dropdown:hover .nav-submenu { display: block; }
.nav-submenu-link {
    display: block;
    padding: 8px 18px;
    color: #ccc;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
}
.nav-submenu-link:hover { background: rgba(0,212,255,0.1); color: #00d4ff; }
.submenu-separator { border-top: 1px solid rgba(0,212,255,0.15); margin: 4px 0; }
@@media (max-width: 768px) {
    .nav-submenu { position: static; border: none; background: rgba(0,212,255,0.05); box-shadow: none; }
    .nav-dropdown:hover .nav-submenu { display: block; }
}
</style>
<script src="/templatemo-electric-scripts.js" asp-append-version="true"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>