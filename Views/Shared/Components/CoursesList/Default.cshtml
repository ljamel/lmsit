    /* ===== Fin mise en évidence ===== */

    .d-none {
        display: none;
    }
    .app-onboarding-active {
        overflow: auto;
    }

    .onboarding-arrow-indicator {
        display: none;
        position: fixed;
        top: 7vh;
        width: min(20%, 1250px);
        z-index: 1080;
        opacity: 0;
        animation: onboardingArrowTraverse 0.1s ease-out forwards;
        color: #fff3a3;
