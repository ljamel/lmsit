@model IEnumerable<CrudDemo.Models.Course>

@{
    var canAccessPremium = (bool?)ViewBag.CanAccessPremium ?? false;
    var canAccessEntraide = (bool?)ViewBag.CanAccessEntraide ?? false;
    var canAccessKaliSandbox = (bool?)ViewBag.CanAccessKaliSandbox ?? false;
    var firstCourseId = (int?)ViewBag.FirstCourseId ?? 0;
    var trackedCourseIds = ViewBag.TrackedCourseIds as HashSet<int> ?? new HashSet<int>();
    var trackedLessonIds = ViewBag.TrackedLessonIds as HashSet<int> ?? new HashSet<int>();
    var trackedLessonsCount = (int?)ViewBag.UserTrackedLessonsCount ?? 0;
    var totalLessonsCount = (int?)ViewBag.UserTotalLessonsCount ?? 0;
    var courseProgressPercent = (double?)ViewBag.UserCourseProgressPercent ?? 0;
    var isCertificateEligible = (bool?)ViewBag.IsCertificateEligible ?? false;
    var earnedQuizPoints = (int?)ViewBag.EarnedQuizPoints ?? 0;
    var totalQuizPoints = (int?)ViewBag.TotalQuizPoints ?? 0;
    var certificateScorePercent = (double?)ViewBag.CertificateScorePercent ?? 0;
    var completedQuizCount = (int?)ViewBag.CompletedQuizCount ?? 0;
    var totalQuizCount = (int?)ViewBag.TotalQuizCount ?? 0;
    var certificateAction = isCertificateEligible ? "Certif1" : "Member";
    var preferredModuleIds = ViewBag.PreferredModuleIds as HashSet<int> ?? new HashSet<int>();
}

<div class="ingenius-shell">
    <div class="menu-dashboard">
    <aside class="ingenius-nav" id="applications-onboarding-section" data-app-onboarding="section">

<a class="logo-link" href="/Courses">
        <svg class="logo-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#FF5E00;stop-opacity:1"></stop>
                    <stop offset="100%" style="stop-color:#00B2FF;stop-opacity:1"></stop>
                </linearGradient>
            </defs>
            <polygon points="20,2 38,14 38,26 20,38 2,26 2,14" fill="none" stroke="url(#logoGradient)" stroke-width="2"></polygon>
            <polygon points="20,8 32,16 32,24 20,32 8,24 8,16" fill="url(#logoGradient)" opacity="0.3"></polygon>
            <circle cx="20" cy="20" r="3" fill="url(#logoGradient)"></circle>
        </svg>
        <span class="logo-text">INGENIUS</span>
    </a>

    <a data-onboarding-app="cours"
       id="ingenius-cours-toggle"
       asp-controller="Courses"
       asp-action="Index"
       class="ingenius-nav-link ingenius-nav-active"
       aria-expanded="false"
       aria-controls="ingenius-courses-panel">
        <i class="fa-solid fa-book-open"></i> Mes cours
    </a>

        <div class="onboarding-arrow-indicator" aria-hidden="true">
            <span class="onboarding-arrow-track"></span>
            <span class="onboarding-arrow-shape">⬅</span>
        </div>

        <div id="applications-onboarding" data-app-onboarding="box" class="alert alert-primary py-3 px-3 mt-2 mb-3 d-none" role="dialog" aria-modal="true" aria-label="Onboarding applications">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="onboarding-heading">Tour rapide des applications 👋 <span class="onboarding-live-badge">GUIDE</span></strong>
                <span id="applications-onboarding-step" data-app-onboarding="step" class="badge text-bg-light">Étape 1/8</span>
            </div>

            <div class="progress mb-2" style="height: 6px;">
                <div
                    id="applications-onboarding-progress"
                    data-app-onboarding="progress"
                    class="progress-bar progress-bar-striped progress-bar-animated"
                    role="progressbar"
                    style="width: 12.5%;"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="13">
                </div>
            </div>

            <div class="d-flex flex-wrap gap-1 mb-2" data-app-onboarding="chips"></div>

            <div class="mb-2">
                <p id="applications-onboarding-title" data-app-onboarding="title" class="mb-1 fw-semibold">ENTRAIDE</p>
                <p id="applications-onboarding-description" data-app-onboarding="description" class="mb-0">Pose des questions et échange avec la communauté sur Discord.</p>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <small class="text-muted" data-app-onboarding="hint">Le lien en cours est mis en évidence dans la liste.</small>
                <div class="d-flex gap-2">
                    <button id="applications-onboarding-open" data-app-onboarding="open" type="button" class="btn btn-sm btn-outline-dark d-none">Ouvrir</button>
                    <button id="applications-onboarding-skip" data-app-onboarding="skip" type="button" class="btn btn-sm btn-outline-secondary">Passer</button>
                    <button id="applications-onboarding-prev" data-app-onboarding="prev" type="button" class="btn btn-sm btn-outline-primary" disabled>Précédent</button>
                    <button id="applications-onboarding-next" data-app-onboarding="next" type="button" class="btn btn-sm btn-primary onboarding-next-cta">Suivant</button>
                </div>
            </div>
        </div>
        @if (canAccessKaliSandbox)
        {
            <a data-onboarding-app="kali" href="#" class="monBouton ingenius-nav-link"><i class="fa-solid fa-computer"></i> Kali Linux Sandbox</a>
        }
        else
        {
            <a data-onboarding-app="kali" class="premium-link ingenius-nav-link" href="/Payment/SubscriptionCheckout"><i class="fa-solid fa-crown"></i> Kali Linux Sandbox <span class="premium-badge">PREMIUM</span></a>
        }

        <p class="ingenius-nav-section-label">Communauté</p>

        @if (canAccessEntraide)
        {
            <a data-onboarding-app="entraide" class="ingenius-nav-link" href="https://discord.gg/ZJGDPfVwMt" target="_blank" rel="noopener"><i class="fas fa-comments"></i> Entraide</a>
        }
        else
        {
            <a data-onboarding-app="entraide" class="premium-link ingenius-nav-link" href="/Payment/SubscriptionCheckout"><i class="fa-solid fa-crown"></i> Entraide <span class="premium-badge">PREMIUM</span></a>
        }
        @if (canAccessPremium)
        {
            <a data-onboarding-app="event" class="ingenius-nav-link" asp-controller="Courses" asp-action="Event"><i class="fa-regular fa-calendar"></i> Évènements</a>
        }
        else
        {
            <a data-onboarding-app="event" class="premium-link ingenius-nav-link" href="/Payment/SubscriptionCheckout"><i class="fa-solid fa-crown"></i> Évènements <span class="premium-badge">PREMIUM</span></a>
        }
        @if (canAccessPremium)
        {
            <a data-onboarding-app="ctf" class="ingenius-nav-link" asp-controller="Challenges" asp-action="Index"><i class="fa-solid fa-hat-cowboy"></i> Plateforme CTF guidé</a>
        }
        else
        {
            <a data-onboarding-app="ctf" class="premium-link ingenius-nav-link" href="/Payment/SubscriptionCheckout"><i class="fa-solid fa-crown"></i> Plateforme CTF guidé <span class="premium-badge">PREMIUM</span></a>
        }
        @if (canAccessPremium)
        {
            <a data-onboarding-app="challenges" class="ingenius-nav-link" asp-controller="Courses" asp-action="Ctf"><i class="fa-solid fa-gift"></i> Challenges cadeaux</a>
        }
        else
        {
            <a data-onboarding-app="challenges" class="premium-link ingenius-nav-link" href="/Payment/SubscriptionCheckout"><i class="fa-solid fa-crown"></i> Challenges cadeaux <span class="premium-badge">PREMIUM</span></a>
        }

        <a data-onboarding-app="certification"
           asp-controller="Courses"
           asp-action="@certificateAction"
           class="certification-link ingenius-cert-btn @(isCertificateEligible ? "certification-ready" : "certification-pending")"
           data-certification-toggle="@(isCertificateEligible ? "disabled" : "pending")"
           aria-expanded="@(isCertificateEligible ? "true" : "false")">
            <i class="fas fa-certificate"></i>
            @(isCertificateEligible ? "Certification disponible" : "Certifications (conditions)")
        </a>
        <div class="certification-conditions @(isCertificateEligible ? "is-ready" : "is-pending") @(isCertificateEligible ? string.Empty : "d-none")"
             data-certification-conditions="@(isCertificateEligible ? "ready" : "pending")">
            <div><strong>Points:</strong> @earnedQuizPoints / @totalQuizPoints (@certificateScorePercent.ToString("0.0")%)</div>
            <div><strong>Quiz:</strong> @completedQuizCount / @totalQuizCount complétés</div>
            <div class="conditions-text">Compléter les exercices avec un score minimal de 80 %.</div>
        </div>

        <div class="ingenius-nav-progress mb-3" aria-label="Progression des cours">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted">Progression des leçons</small>
                <small class="text-muted">@trackedLessonsCount/@totalLessonsCount (@courseProgressPercent%)</small>
            </div>
            <div class="progress" style="height: 8px;">
                <div
                    class="progress-bar"
                    role="progressbar"
                    style="width: @courseProgressPercent%;"
                    aria-valuenow="@courseProgressPercent"
                    aria-valuemin="0"
                    aria-valuemax="100"></div>
            </div>
        </div>
    </aside>
    </div>

    <section class="ingenius-courses-panel d-none" id="ingenius-courses-panel">
    <h2>Mes cours</h2>

    @{
        var lessonSearchTerm = (Context.Request.Query["lessonSearch"].ToString() ?? string.Empty).Trim();
        var hasLessonSearch = !string.IsNullOrEmpty(lessonSearchTerm);
        var hasAnyLessonMatch = false;

        Func<string?, string> stripHtml = (html) => {
            if (string.IsNullOrWhiteSpace(html)) return string.Empty;
            var decoded = System.Net.WebUtility.HtmlDecode(html);
            return System.Text.RegularExpressions.Regex.Replace(decoded, "<[^>]*>", " ").Trim();
        };

        Func<CrudDemo.Models.Lesson, bool> lessonMatchesSearch = (l) => {
            if (!hasLessonSearch) return true;
            var titleMatch = !string.IsNullOrEmpty(l.Title) &&
                l.Title.Contains(lessonSearchTerm, StringComparison.OrdinalIgnoreCase);
            var descPlain = stripHtml(l.Description);
            var descMatch = descPlain.Contains(lessonSearchTerm, StringComparison.OrdinalIgnoreCase);
            return titleMatch || descMatch;
        };
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();
        var currentIdRaw = (ViewContext.RouteData.Values["id"]?.ToString() ?? string.Empty).Trim();
        var hasCurrentId = int.TryParse(currentIdRaw, out var currentId);
    }

    <form method="get" asp-controller="Courses" asp-action="Index" class="mb-3">
        <div class="input-group">
            <input
                data-onboarding-app="champ-recherche"
                id="lesson-search"
                name="lessonSearch"
                type="search"
                class="form-control"
                placeholder="Ex : sécurité, réseaux, ..."
                value="@lessonSearchTerm"
                aria-label="Chercher une leçon"/><br/>
            <button data-onboarding-app="rechercher" class="btn btn-primary" type="submit">Rechercher</button>
            @if (hasLessonSearch)
            {
                <a class="btn btn-outline-secondary" asp-controller="Courses" asp-action="Index">Effacer</a>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>Aucun cours disponible pour le moment.</p>
        </div>
    }
    else
    {
        <div class="ingenius-course-tree">

            @{ var module = 0; }
            @foreach (var course in Model)
            {
                ++module;
                var isLockedCourse = !canAccessPremium && firstCourseId > 0 && course.Id != firstCourseId;
                var modules = course.Modules ?? new List<CrudDemo.Models.Module>();
                if (hasLessonSearch)
                {
                    modules = modules
                        .Where(m => m.Lessons != null && m.Lessons.Any(l => lessonMatchesSearch(l)))
                        .ToList();

                    if (!modules.Any())
                    {
                        continue;
                    }
                }

                var courseCollapseId = "course-collapse-" + course.Id;
                var expandCourse = isLockedCourse || (hasLessonSearch && modules.Any());

                <div class="ingenius-course-block">
                    @if (isLockedCourse)
                    {
                        <a class="ingenius-course-title premium-link" href="/Payment/SubscriptionCheckout">
                            <i class="fa-solid fa-crown"></i> @course.Title <span class="premium-badge">PREMIUM</span>
                        </a>
                    }
                    else
                    {
                        <a
                            class="ingenius-course-title ingenius-collapse-toggle"
                            href="#@courseCollapseId"
                            role="button"
                            aria-expanded="@(expandCourse ? "true" : "false")"
                            aria-controls="@courseCollapseId">
                            <i class="fas fa-chevron-right ingenius-course-chevron"></i>
                            @course.Title
                        </a>
                    }

                    <div class="ingenius-collapse @(expandCourse ? string.Empty : "d-none")" id="@courseCollapseId">
                    @foreach (var m in modules)
                    {
                        var lessons = (m.Lessons ?? new List<CrudDemo.Models.Lesson>()).OrderBy(l => l.OrderIndex).ToList();
                        if (hasLessonSearch)
                        {
                            lessons = lessons
                                .Where(l => lessonMatchesSearch(l))
                                .OrderBy(l => l.Title != null && l.Title.Contains(lessonSearchTerm, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                                .ThenBy(l => l.OrderIndex)
                                .ToList();
                        }

                        var moduleCollapseId = "module-collapse-" + m.Id;
                        var expandModule = hasLessonSearch && lessons.Any();

                        <div class="ingenius-module">
                            <a
                                class="ingenius-module-header ingenius-collapse-toggle @(preferredModuleIds.Contains(m.Id) ? "module-preferred-title" : string.Empty)"
                                href="#@moduleCollapseId"
                                role="button"
                                aria-expanded="@(expandModule ? "true" : "false")"
                                aria-controls="@moduleCollapseId">
                                <i class="fas fa-chevron-right ingenius-module-chevron"></i>
                                @if (preferredModuleIds.Contains(m.Id))
                                {
                                    <i class="fas fa-star" style="color:#FFD700;"></i>
                                }
                                <span class="ingenius-module-title">@m.Title</span>
                                @if (preferredModuleIds.Contains(m.Id))
                                {
                                    <span class="preferred-module-badge">Prioritaire</span>
                                }
                            </a>

                            @if (lessons.Any())
                            {
                                <div class="ingenius-collapse @(expandModule ? string.Empty : "d-none")" id="@moduleCollapseId">
                                    <ul class="ingenius-lesson-list">
                                        @foreach (var lesson in lessons)
                                        {
                                            if (hasLessonSearch)
                                            {
                                                hasAnyLessonMatch = true;
                                            }

                                            var isSelectedLesson = currentAction.Equals("Lesson", StringComparison.OrdinalIgnoreCase)
                                                && hasCurrentId
                                                && currentId == lesson.Id;
                                            var hasVideo = !string.IsNullOrWhiteSpace(lesson.Description)
                                                && (
                                                    lesson.Description.Contains("<video", StringComparison.OrdinalIgnoreCase)
                                                    || lesson.Description.Contains("<iframe", StringComparison.OrdinalIgnoreCase)
                                                    || lesson.Description.Contains("&lt;video", StringComparison.OrdinalIgnoreCase)
                                                    || lesson.Description.Contains("&lt;iframe", StringComparison.OrdinalIgnoreCase)
                                                );
                                            var hasQuiz = lesson.Quizzes.Any();

                                            <li>
                                                @if (isLockedCourse)
                                                {
                                                    <a href="/Payment/SubscriptionCheckout" class="lesson-link premium-link">
                                                        <i class="fa-solid fa-lock"></i> @lesson.Title <span class="premium-badge">PREMIUM</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="Lesson" asp-route-id="@lesson.Id" class="lesson-link @(isSelectedLesson ? "menu-item-active" : string.Empty)">
                                                        @if (trackedLessonIds.Contains(lesson.Id))
                                                        {
                                                            <i class="fas fa-check text-success" aria-label="Leçon suivie"></i>
                                                        }
                                                        @if (hasVideo)
                                                        {
                                                            <i class="fas fa-play-circle"></i>
                                                        }
                                                        @if (hasQuiz)
                                                        {
                                                            <i class="fa-solid fa-circle-question" title="Quiz disponible"></i>
                                                        }
                                                        @lesson.Title
                                                    </a>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                    </div>
                </div>
            }
        </div>

        @if (hasLessonSearch && !hasAnyLessonMatch)
        {
            <div class="alert alert-info mt-3">
                <p>Aucune leçon trouvée pour « @lessonSearchTerm ».</p>
            </div>
        }
    }
    </section>
</div>

<script>
    (function () {
        var coursToggle = document.getElementById('ingenius-cours-toggle');
        var coursesPanel = document.getElementById('ingenius-courses-panel');

        if (!coursToggle || !coursesPanel) {
            return;
        }

        coursToggle.addEventListener('click', function (event) {
            event.preventDefault();
            var isHidden = coursesPanel.classList.toggle('d-none');
            coursToggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
    })();

    (function () {
        document.addEventListener('click', function (event) {
            var toggle = event.target.closest('.ingenius-collapse-toggle');
            if (!toggle) {
                return;
            }

            event.preventDefault();

            var targetId = (toggle.getAttribute('href') || '').replace('#', '');
            if (!targetId) {
                return;
            }

            var target = document.getElementById(targetId);
            if (!target) {
                return;
            }

            var isHidden = target.classList.toggle('d-none');
            toggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
    })();
</script>

<style>
