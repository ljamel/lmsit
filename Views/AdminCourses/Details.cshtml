@model CrudDemo.Models.Course

@{
    ViewData["Title"] = "Détails du Cours - Admin";
}

<div class="admin-courses-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="animated-section mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="animated-title">
                    <i class="fas fa-book"></i> @Model.Title
                    <button type="button" class="btn btn-sm btn-outline-warning ms-2 btn-rename-course"
                            data-courseid="@Model.Id"
                            data-title="@Model.Title"
                            title="Renommer le cours">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                </h1>
                <p class="text-muted animated-description">
                    <i class="fas fa-user-circle"></i> Créé par: <strong>@Model.CreatedBy</strong>
                </p>
            </div>
            <div>
                <a class="btn btn-primary btn-lg animated-btn" 
                   asp-action="CreateModule" asp-route-courseId="@Model.Id">
                    <i class="fas fa-plus"></i> Ajouter Module
                </a>
                <a class="btn btn-secondary btn-lg animated-btn" asp-action="Index">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <div class="card animated-card mb-4">
            <div class="card-body">
                <p>@Model.Description</p>
            </div>
        </div>
    </div>

    <h3 class="mb-4">
        <i class="fas fa-cubes"></i> Modules et Leçons
    </h3>

    @if (Model.Modules == null || !Model.Modules.Any())
    {
        <div class="alert alert-info animated-alert">
            <i class="fas fa-info-circle"></i> Aucun module pour le moment. Créez-en un!
        </div>
    }
    else
    {
        <div class="modules-list">
            @foreach (var m in Model.Modules.OrderBy(m => m.OrderIndex))
            {
                <div class="card module-card animated-card mb-3">
                    <div class="card-header gradient-module-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">
                                    <i class="fas fa-layer-group"></i> @m.Title
                                    <button type="button" class="btn btn-sm btn-outline-light ms-2 btn-rename-module"
                                            data-moduleid="@m.Id"
                                            data-title="@m.Title"
                                            title="Renommer le module">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                </h5>
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <small class="text-muted">@m.Description</small>
                                }
                            </div>
                            <a class="btn btn-sm btn-outline-light animated-btn" 
                               asp-action="CreateLesson" asp-route-moduleId="@m.Id">
                                <i class="fas fa-plus-circle"></i> Ajouter Leçon
                            </a>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (m.Lessons == null || !m.Lessons.Any())
                        {
                            <p class="text-muted"><em>Aucune leçon dans ce module</em></p>
                        }
                        else
                        {
                            <div class="lessons-list">
                                @foreach (var l in m.Lessons.OrderBy(l => l.OrderIndex))
                                {
                                    <div class="lesson-item animated-lesson">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">
                                                    <i class="fas fa-video"></i> @l.Title 
                                                </h6>

                                                <!-- Quiz Section -->
                                                @if (l.Quizzes != null && l.Quizzes.Any())
                                                {
                                                    <div class="quiz-section mt-2">
                                                        <h6 class="mb-2">
                                                            <i class="fas fa-question-circle"></i> Quiz (@l.Quizzes.Count)
                                                        </h6>
                                                        <ul class="list-unstyled ms-3">
                                                            @foreach (var quiz in l.Quizzes)
                                                            {
                                                                <li class="mb-2 quiz-item animated-quiz">
                                                                    <span class="badge bg-info">@quiz.Question</span>
                                                                    <span class="badge bg-secondary">@quiz.Options.Count options</span>
                                                                    <span class="badge bg-warning">@quiz.Points pts</span>
                                                                    <a class="btn btn-xs btn-sm btn-outline-primary ms-2" 
                                                                       asp-action="EditQuiz" asp-route-quizId="@quiz.Id">
                                                                        <i class="fas fa-edit"></i>
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <small class="text-muted d-block">Aucun quiz</small>
                                                }
                                            </div>
                                            <div class="btn-group-vertical ms-2" role="group">
                                                <a class="btn btn-sm btn-outline-warning animated-btn mb-1" 
                                                   asp-action="EditLesson" asp-route-lessonId="@l.Id" 
                                                   title="Éditer la leçon">
                                                    <i class="fas fa-edit"></i> Éditer
                                                </a>
                                                <a class="btn btn-sm btn-outline-primary animated-btn" 
                                                   asp-action="CreateQuiz" asp-route-lessonId="@l.Id" 
                                                   title="Ajouter un quiz">
                                                    <i class="fas fa-plus"></i> Quiz
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Renommer le cours -->
<div class="modal fade" id="renameCourseModal" tabindex="-1" aria-labelledby="renameCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border border-warning">
            <div class="modal-header border-warning">
                <h5 class="modal-title" id="renameCourseModalLabel"><i class="fas fa-pencil-alt text-warning"></i> Renommer le cours</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="renameCourseForm" method="post" action="/AdminCourses/RenameCourse">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="courseId" id="renameCourseId" />
                    <div class="mb-3">
                        <label for="renameCourseTitle" class="form-label">Nouveau titre</label>
                        <input type="text" class="form-control bg-dark text-white border-warning" id="renameCourseTitle" name="title" required maxlength="200" />
                    </div>
                </div>
                <div class="modal-footer border-warning">
                    <button type="submit" class="btn btn-warning" id="renameCourseSubmit" disabled><i class="fas fa-save"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Renommer un module -->
<div class="modal fade" id="renameModuleModal" tabindex="-1" aria-labelledby="renameModuleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border border-primary">
            <div class="modal-header border-primary">
                <h5 class="modal-title" id="renameModuleModalLabel"><i class="fas fa-pencil-alt text-primary"></i> Renommer le module</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="renameModuleForm" method="post" action="/AdminCourses/RenameModule">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="moduleId" id="renameModuleId" />
                    <div class="mb-3">
                        <label for="renameModuleTitle" class="form-label">Nouveau titre</label>
                        <input type="text" class="form-control bg-dark text-white border-primary" id="renameModuleTitle" name="title" required maxlength="200" />
                    </div>
                </div>
                <div class="modal-footer border-primary">
                    <button type="submit" class="btn btn-primary" id="renameModuleSubmit" disabled><i class="fas fa-save"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    document.querySelectorAll('.btn-rename-course').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('renameCourseId').value = this.dataset.courseid;
            document.getElementById('renameCourseTitle').value = this.dataset.title;
            document.getElementById('renameCourseSubmit').disabled = false;
            new bootstrap.Modal(document.getElementById('renameCourseModal')).show();
        });
    });

    document.querySelectorAll('.btn-rename-module').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('renameModuleId').value = this.dataset.moduleid;
            document.getElementById('renameModuleTitle').value = this.dataset.title;
            document.getElementById('renameModuleSubmit').disabled = false;
            new bootstrap.Modal(document.getElementById('renameModuleModal')).show();
        });
    });
})();
</script>

<style>
    .admin-courses-container {
        padding: 20px 0;
    }

    .animated-title {
        color: #667eea;
        animation: slideDown 0.5s ease-out;
    }

    .animated-description {
        animation: slideDown 0.6s ease-out 0.1s both;
    }

    .animated-section {
        animation: fadeIn 0.5s ease-out;
    }

    .animated-card {
        border: 1px solid #e0e0e0;
        transition: all 0.3s ease;
        border-radius: 12px;
    }

    .animated-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        border-color: #667eea;
    }

    .module-card {
        border-left: 5px solid #667eea;
    }

    .gradient-module-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

    .lesson-item {
        padding: 15px;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 12px;
        animation: slideInLeft 0.4s ease-out;
        transition: all 0.3s ease;
    }

    .lesson-item:hover {
        background-color: #f8f9fa;
        border-color: #667eea;
    }

    .quiz-section {
        background-color: #f0f4ff;
        padding: 10px;
        border-radius: 6px;
    }

    .quiz-item {
        animation: fadeIn 0.5s ease-out;
        transition: all 0.3s ease;
    }

    .quiz-item:hover {
        transform: translateX(5px);
    }

    .animated-btn {
        transition: all 0.3s ease;
    }

    .animated-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

    .animated-alert {
        animation: slideUp 0.4s ease-out;
        border-radius: 8px;
        border: 1px solid #d3e5ff;
        background-color: #e7f3ff;
    }

    .lessons-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>

