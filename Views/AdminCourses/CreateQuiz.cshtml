@{
    ViewData["Title"] = "Créer un Quiz";
    var lesson = ViewBag.Lesson as CrudDemo.Models.Lesson;
    var lessonId = ViewBag.LessonId;
}

<div class="container mt-4">
    <div class="animated-section">
        <div class="mb-4">
            <a asp-action="Details" asp-route-id="@lesson?.Module?.CourseId" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <div class="card shadow-lg animated-card">
            <div class="card-header gradient-header">
                <h2 class="mb-0"><i class="fas fa-plus-circle"></i> Créer un Quiz</h2>
                <small class="text-white">@lesson?.Title</small>
            </div>

            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="CreateQuiz" method="post" id="quizForm">
                    <input type="hidden" name="lessonId" value="@lessonId" />

                    <div id="questionsContainer"></div>

                    <div class="d-flex gap-2 mb-4">
                        <button type="button" class="btn btn-outline-primary" id="addQuestionBtn">
                            <i class="fas fa-plus"></i> Ajouter une question
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg animated-btn">
                            <i class="fas fa-check"></i> Enregistrer le quiz
                        </button>
                        <a asp-action="Details" asp-route-id="@lesson?.Module?.CourseId" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .animated-section {
        animation: slideUp 0.5s ease-out;
    }

    .animated-card {
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .animated-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }

    .gradient-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1.5rem;
    }

    .animated-input {
        border: 2px solid #e0e0e0;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
        border-radius: 8px;
        padding: 0.75rem;
    }

    .animated-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }

    .animated-option {
        transition: opacity 0.3s ease, transform 0.3s ease;
        animation: slideInLeft 0.4s ease-out forwards;
    }

    .animated-option:hover {
        transform: translateX(5px);
    }

    .animated-btn {
        transition: all 0.3s ease;
    }

    .animated-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

    .question-card { border: 1px solid #e0e0e0; border-radius: 10px; padding: 1rem; margin-bottom: 1rem; }
    .question-title { font-weight: 600; color: #667eea; }
    .option-item .input-group-text { background-color: #f8f9fa; }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideOut {
        to {
            opacity: 0;
            transform: translateX(-20px);
        }
    }
</style>

<script>
    const questionsContainer = document.getElementById('questionsContainer');
    const addQuestionBtn = document.getElementById('addQuestionBtn');
    const quizForm = document.getElementById('quizForm');
    let questionCount = 0;

    function buildOptionRow(questionIndex, optionIndex) {
        const row = document.createElement('div');
        row.className = 'option-item mb-2';
        row.innerHTML = `
            <div class="input-group">
                <input type="text" class="form-control animated-input option-text" name="optionTexts_${questionIndex}" placeholder="Option ${optionIndex + 1}" required>
                <div class="input-group-text">
                    <input type="checkbox" class="form-check-input option-correct" data-question-index="${questionIndex}" data-option-index="${optionIndex}">
                    <label class="ms-2 mb-0">Correcte</label>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm remove-option"><i class="fas fa-trash"></i></button>
            </div>
        `;
        return row;
    }

    function updateOptionIndexes(questionCard) {
        const questionIndex = Number(questionCard.dataset.questionIndex);
        const options = questionCard.querySelectorAll('.option-item');
        options.forEach((item, optionIndex) => {
            const input = item.querySelector('.option-text');
            const checkbox = item.querySelector('.option-correct');
            input.placeholder = `Option ${optionIndex + 1}`;
            checkbox.dataset.questionIndex = questionIndex;
            checkbox.dataset.optionIndex = optionIndex;
        });
    }

    function addOption(questionCard) {
        const questionIndex = Number(questionCard.dataset.questionIndex);
        const optionsContainer = questionCard.querySelector('.question-options');
        const optionIndex = optionsContainer.querySelectorAll('.option-item').length;
        const row = buildOptionRow(questionIndex, optionIndex);
        optionsContainer.appendChild(row);

        row.querySelector('.remove-option').addEventListener('click', () => {
            const options = optionsContainer.querySelectorAll('.option-item');
            if (options.length <= 2) {
                return;
            }
            row.remove();
            updateOptionIndexes(questionCard);
        });
    }

    function addQuestion() {
        const questionIndex = questionCount++;
        const card = document.createElement('div');
        card.className = 'question-card animated-option';
        card.dataset.questionIndex = questionIndex;
        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="question-title"><i class="fas fa-question-circle"></i> Question ${questionIndex + 1}</div>
            </div>

            <input type="hidden" name="correctIndexes_${questionIndex}" class="correct-indexes" value="">

            <div class="form-group mb-3">
                <label class="form-label">Texte de la question</label>
                <textarea class="form-control animated-input" name="questionTexts" rows="2" maxlength="500" required></textarea>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Description (optionnel)</label>
                <textarea class="form-control animated-input" name="questionDescriptions" rows="2" maxlength="1000"></textarea>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Points</label>
                <input type="number" class="form-control animated-input" name="questionPoints" value="1" min="1" max="100" required>
            </div>

            <h6 class="mb-2"><i class="fas fa-list"></i> Options de réponse</h6>
            <div class="question-options"></div>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2 add-option-btn"><i class="fas fa-plus"></i> Ajouter une option</button>
        `;

        const optionsContainer = card.querySelector('.question-options');
        optionsContainer.appendChild(buildOptionRow(questionIndex, 0));
        optionsContainer.appendChild(buildOptionRow(questionIndex, 1));

        card.querySelectorAll('.remove-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const options = optionsContainer.querySelectorAll('.option-item');
                if (options.length <= 2) {
                    return;
                }
                e.target.closest('.option-item').remove();
                updateOptionIndexes(card);
            });
        });

        card.querySelector('.add-option-btn').addEventListener('click', () => addOption(card));
        questionsContainer.appendChild(card);
    }

    addQuestionBtn.addEventListener('click', addQuestion);

    quizForm.addEventListener('submit', function (e) {
        const questionCards = questionsContainer.querySelectorAll('.question-card');
        if (questionCards.length === 0) {
            e.preventDefault();
            alert('Ajoutez au moins une question.');
            return;
        }

        for (const card of questionCards) {
            const options = Array.from(card.querySelectorAll('.option-item'));
            const validOptions = options
                .map((option, idx) => ({ idx, value: option.querySelector('.option-text').value.trim(), checked: option.querySelector('.option-correct').checked }))
                .filter(option => option.value.length > 0);

            if (validOptions.length < 2) {
                e.preventDefault();
                alert('Chaque question doit avoir au moins 2 options non vides.');
                return;
            }

            const correctIndexes = validOptions.filter(o => o.checked).map(o => o.idx);
            if (correctIndexes.length === 0) {
                e.preventDefault();
                alert('Chaque question doit avoir au moins une bonne réponse.');
                return;
            }

            card.querySelector('.correct-indexes').value = correctIndexes.join(',');
        }
    });

    addQuestion();
</script>
