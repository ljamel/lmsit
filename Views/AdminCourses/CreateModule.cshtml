@model CrudDemo.Models.Module

@{
    ViewData["Title"] = "Create Module";
}

<h1>Create Module</h1>
@if (!string.IsNullOrEmpty(ViewBag.CourseName))
{
    <p class="text-muted">For course: <strong>@ViewBag.CourseName</strong></p>
}

<form asp-action="CreateModule" method="post">
    <input type="hidden" name="CourseId" value="@ViewBag.CourseId" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    
    <div class="form-group mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    
    <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="form-group mb-3">
        <label asp-for="OrderIndex"></label>
        <input asp-for="OrderIndex" class="form-control" type="number" value="1" />
        <span asp-validation-for="OrderIndex" class="text-danger"></span>
        <small class="form-text text-muted">Order in which this module appears in the course</small>
    </div>
    
    <button type="submit" class="btn btn-primary">Create Module</button>
    <a class="btn btn-secondary" href="/AdminCourses/Details/@ViewBag.CourseId">Back</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}