@model IEnumerable<CrudDemo.Models.AdminUserRowViewModel>

@{
    ViewData["Title"] = "Utilisateurs Inscrits";
    var userRows = Model ?? Enumerable.Empty<CrudDemo.Models.AdminUserRowViewModel>();
    var totalUsers = (int?)ViewBag.TotalUsers ?? 0;
    var activeSubscriptions = (int?)ViewBag.ActiveSubscriptions ?? 0;
    var withoutSubscription = (int?)ViewBag.WithoutSubscription ?? 0;
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
    var searchQuery = (string?)ViewBag.SearchQuery;
    var bulkEmailModel = ViewBag.BulkEmailModel as CrudDemo.Models.AdminBulkEmailViewModel
        ?? new CrudDemo.Models.AdminBulkEmailViewModel();
    var competencyRows = ViewBag.QuizCompetencyRows as IEnumerable<CrudDemo.Models.AdminUserQuizResultRowViewModel>
        ?? Enumerable.Empty<CrudDemo.Models.AdminUserQuizResultRowViewModel>();
}


<div class="users-page">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 style="color: #00B2FF; text-shadow: 0 0 20px rgba(0,178,255,0.5); font-family: 'Orbitron', sans-serif;">
                <i class="fas fa-users me-2"></i>Utilisateurs Inscrits
            </h1>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour aux Cours
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-custom mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert-success-custom mb-4">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
            </div>
        }

        <!-- Barre de recherche -->
        <div class="search-container mb-4">
            <form method="get" asp-action="Users" class="d-flex gap-2">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid #00B2FF; color: #00B2FF;">
                        <i class="fas fa-search"></i>
                    </span>
                    <input 
                        type="text" 
                        name="search" 
                        class="form-control" 
                        placeholder="Rechercher par email ou nom d'utilisateur..." 
                        value="@ViewBag.SearchQuery"
                        style="background: #16213e; border: 1px solid #00B2FF; color: #fff;"
                    />
                </div>
                <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #00B2FF 0%, #0080FF 100%); border: none;">
                    <i class="fas fa-search me-1"></i> Rechercher
                </button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery))
                {
                    <a asp-action="Users" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Effacer
                    </a>
                }
            </form>
        </div>

        <div class="stats-cards mb-4">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-info">
                    <h3>@totalUsers</h3>
                    <p>Total Utilisateurs</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active">
                    <i class="fas fa-crown"></i>
                </div>
                <div class="stat-info">
                    <h3>@activeSubscriptions</h3>
                    <p>Abonnements Actifs</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon inactive">
                    <i class="fas fa-user-times"></i>
                </div>
                <div class="stat-info">
                    <h3>@withoutSubscription</h3>
                    <p>Sans Abonnement</p>
                </div>
            </div>
        </div>

        <div class="table-container mb-4">
            <h3 style="color:#00B2FF; margin-bottom: 1rem;">
                <i class="fas fa-paper-plane me-2"></i>Email à tous les inscrits
            </h3>

            <form asp-action="SendEmailToAll" method="post" class="bulk-email-form">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Subject" class="form-label" style="color: rgba(255,255,255,0.9);">Objet</label>
                    <input
                        type="text"
                        id="Subject"
                        name="Subject"
                        maxlength="200"
                        required
                        class="form-control"
                        value="@bulkEmailModel.Subject"
                        style="background: #16213e; border: 1px solid #00B2FF; color: #fff;"
                    />
                </div>

                <div class="mb-3">
                    <label for="Message" class="form-label" style="color: rgba(255,255,255,0.9);">Message</label>
                    <textarea
                        id="Message"
                        name="Message"
                        rows="6"
                        maxlength="5000"
                        required
                        class="form-control"
                        style="background: #16213e; border: 1px solid #00B2FF; color: #fff;">@bulkEmailModel.Message</textarea>
                </div>

                <div class="form-check mb-3">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="OnlyActiveSubscribers"
                        name="OnlyActiveSubscribers"
                        value="true"
                        @(bulkEmailModel.OnlyActiveSubscribers ? "checked" : "")
                    />
                    <label class="form-check-label" for="OnlyActiveSubscribers" style="color: rgba(255,255,255,0.9);">
                        Envoyer uniquement aux abonnés actifs
                    </label>
                </div>

                <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #00B2FF 0%, #0080FF 100%); border: none;">
                    <i class="fas fa-paper-plane me-1"></i> Envoyer à tous les inscrits
                </button>
            </form>
        </div>

        <div class="mb-3" style="color: rgba(255,255,255,0.8); font-family: 'Rajdhani', sans-serif;">
            <i class="fas fa-sort-amount-down me-1" style="color:#00B2FF;"></i>
            Tri des utilisateurs par date (abonnement puis activité récente)
        </div>

        <div class="table-container">
            <table class="users-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-user me-2"></i>Email</th>
                        <th><i class="fas fa-shield-alt me-2"></i>Statut Abonnement</th>
                        <th><i class="fas fa-calendar-alt me-2"></i>Date Début</th>
                        <th><i class="fas fa-graduation-cap me-2"></i>Cours Suivis</th>
                        <th><i class="fas fa-tasks me-2"></i>Leçons Quiz</th>
                        <th><i class="fas fa-question-circle me-2"></i>Tentatives Quiz</th>
                        <th><i class="fas fa-check-circle me-2"></i>Bonnes Réponses</th>
                        <th><i class="fas fa-comments me-2"></i>Commentaires</th>
                        <th><i class="fas fa-clock me-2"></i>Dernière Activité</th>
                        <th><i class="fas fa-credit-card me-2"></i>ID Stripe</th>
                        <th><i class="fas fa-user-slash me-2"></i>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        #pragma warning disable CS8602
                    }
                    @foreach (var item in userRows)
                    {
                        bool hasSubscription = item.HasSubscription;
                        var hasActiveSubscription = item.IsActiveSubscription;
                        
                        <tr class="@(hasActiveSubscription ? "active-user" : "inactive-user")">
                            <td>
                                <div class="user-email">
                                    <i class="fas fa-envelope me-2" style="color: #00B2FF;"></i>
                                    @item.Email
                                </div>
                            </td>
                            <td>
                                @if (hasActiveSubscription || hasSubscription)
                                {
                                    <span class="badge-active">
                                        <i class="fas fa-check-circle me-1"></i>
                                        @item.SubscriptionStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-none">
                                        <i class="fas fa-minus-circle me-1"></i>
                                        Aucun
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="date-info">
                                    @item.SubscriptionStartDate?.ToString("dd/MM/yyyy HH:mm")
                                </span>

                            </td>
                            <td>
                                <span class="badge-active">@item.CoursesTracked</span>
                            </td>
                            <td>
                                <span class="date-info">@item.QuizLessonsTracked</span>
                            </td>
                            <td>
                                <span class="date-info">@item.QuizAttempts</span>
                            </td>
                            <td>
                                <span class="date-info">@item.QuizCorrectAnswers</span>
                            </td>
                            <td>
                                <span class="date-info">@item.CommentsCount</span>
                            </td>
                            <td>
                                @if (item.LastActivityAt != null)
                                {
                                    <span class="date-info">@item.LastActivityAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (hasSubscription && !string.IsNullOrEmpty(item.StripeSubscriptionId))
                                {
                                    <code class="stripe-id">@item.StripeSubscriptionId!.Substring(0, Math.Min(20, item.StripeSubscriptionId.Length))...</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <form asp-action="DeactivateMember" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@item.UserId" />
                                    <button type="submit" class="btn-deactivate" @(hasActiveSubscription ? "" : "disabled")>
                                        <i class="fas fa-user-slash me-1"></i>Desactiver
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @{
                        #pragma warning restore CS8602
                    }
                </tbody>
            </table>
        </div>

        @if (!userRows.Any())
        {
            <div class="alert-custom">
                <i class="fas fa-info-circle me-2"></i>
                Aucun utilisateur inscrit pour le moment.
            </div>
        }

        <div class="table-container mt-4">
            <h3 style="color:#00B2FF; margin-bottom: 1rem;">
                <i class="fas fa-chart-line me-2"></i>Tableau de compétence (par utilisateur / quiz)
            </h3>

            @if (competencyRows.Any())
            {
                <table class="users-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-user me-2"></i>Utilisateur</th>
                            <th><i class="fas fa-compass me-2"></i>Orientation</th>
                            <th><i class="fas fa-book me-2"></i>Cours</th>
                            <th><i class="fas fa-list me-2"></i>Leçon</th>
                            <th><i class="fas fa-question-circle me-2"></i>Quiz</th>
                            <th><i class="fas fa-redo me-2"></i>Tentatives</th>
                            <th><i class="fas fa-check me-2"></i>Bonnes réponses</th>
                            <th><i class="fas fa-percentage me-2"></i>Taux de réussite</th>
                            <th><i class="fas fa-signal me-2"></i>Niveau</th>
                            <th><i class="fas fa-clock me-2"></i>Dernier essai</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in competencyRows)
                    {
                        var badgeClass = row.SuccessRate >= 80
                            ? "badge-advanced"
                            : row.SuccessRate >= 50
                                ? "badge-intermediate"
                                : row.SuccessRate > 0
                                    ? "badge-beginner"
                                    : "badge-none";

                        <tr>
                            <td>
                                <div class="user-email">
                                    <i class="fas fa-envelope me-2" style="color: #00B2FF;"></i>
                                    @row.UserEmail
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.OrientationRole))
                                {
                                    <span class="date-info">@row.OrientationRole</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><span class="date-info">@row.CourseTitle</span></td>
                            <td><span class="date-info">@row.LessonTitle</span></td>
                            <td>
                                <span class="date-info" title="@row.QuizQuestion">
                                    @(row.QuizQuestion.Length > 80 ? row.QuizQuestion.Substring(0, 80) + "..." : row.QuizQuestion)
                                </span>
                            </td>
                            <td><span class="date-info">@row.Attempts</span></td>
                            <td><span class="date-info">@row.CorrectAnswers</span></td>
                            <td><span class="date-info">@row.SuccessRate.ToString("0.0")%</span></td>
                            <td>
                                <span class="@badgeClass">
                                    @row.CompetencyLevel
                                </span>
                            </td>
                            <td>
                                @if (row.LastAttemptAt != null)
                                {
                                    <span class="date-info">@row.LastAttemptAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert-custom">
                    <i class="fas fa-info-circle me-2"></i>
                    Aucun résultat de quiz trouvé pour les utilisateurs affichés.
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Pagination utilisateurs" class="mt-4 d-flex justify-content-center">
                <ul class="pagination pagination-custom">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Users" asp-route-page="@(currentPage - 1)" asp-route-search="@searchQuery">Précédent</a>
                    </li>

                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Users" asp-route-page="@pageNumber" asp-route-search="@searchQuery">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Users" asp-route-page="@(currentPage + 1)" asp-route-search="@searchQuery">Suivant</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<style>
    .users-page {
        min-height: 100vh;
        padding: 80px 0 40px;
        position: relative;
        z-index: 1;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: rgba(15, 15, 35, 0.8);
        border: 2px solid rgba(0, 178, 255, 0.3);
        border-radius: 15px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .stat-card:hover {
        border-color: rgba(255, 94, 0, 0.6);
        box-shadow: 0 0 30px rgba(255, 94, 0, 0.3);
        transform: translateY(-5px);
    }

    .badge-advanced,
    .badge-intermediate,
    .badge-beginner {
        display: inline-block;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .badge-advanced {
        color: #00FF88;
        background: rgba(0, 255, 136, 0.15);
        border: 1px solid rgba(0, 255, 136, 0.45);
    }

    .badge-intermediate {
        color: #FFC107;
        background: rgba(255, 193, 7, 0.15);
        border: 1px solid rgba(255, 193, 7, 0.45);
    }

    .badge-beginner {
        color: #FF6B6B;
        background: rgba(255, 107, 107, 0.15);
        border: 1px solid rgba(255, 107, 107, 0.45);
    }

    .pagination-custom .page-link {
        background: rgba(15, 15, 35, 0.85);
        border: 1px solid rgba(0, 178, 255, 0.4);
        color: #00B2FF;
    }

    .pagination-custom .page-item.active .page-link {
        background: linear-gradient(135deg, #00B2FF 0%, #0080FF 100%);
        border-color: #00B2FF;
        color: #ffffff;
    }

    .pagination-custom .page-item.disabled .page-link {
        background: rgba(15, 15, 35, 0.55);
        border-color: rgba(0, 178, 255, 0.2);
        color: rgba(0, 178, 255, 0.45);
    }

    .stat-icon {
        font-size: 2.5rem;
        color: #00B2FF;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 178, 255, 0.1);
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(0, 178, 255, 0.3);
    }

    .stat-icon.active {
        color: #00FF88;
        background: rgba(0, 255, 136, 0.1);
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    }

    .stat-icon.inactive {
        color: #FF5E00;
        background: rgba(255, 94, 0, 0.1);
        box-shadow: 0 0 20px rgba(255, 94, 0, 0.3);
    }

    .stat-info h3 {
        font-size: 2rem;
        color: #fff;
        margin: 0;
        font-family: 'Orbitron', sans-serif;
        text-shadow: 0 0 15px rgba(0, 178, 255, 0.5);
    }

    .stat-info p {
        margin: 0;
        color: rgba(255, 255, 255, 0.7);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1rem;
    }

    .table-container {
        background: rgba(15, 15, 35, 0.8);
        border: 2px solid rgba(0, 178, 255, 0.3);
        border-radius: 15px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.5rem;
    }

    .users-table thead tr {
        background: linear-gradient(90deg, rgba(255, 94, 0, 0.2), rgba(0, 178, 255, 0.2));
    }

    .users-table th {
        padding: 1rem;
        text-align: left;
        color: #00B2FF;
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        border-bottom: 2px solid rgba(0, 178, 255, 0.3);
    }

    .users-table tbody tr {
        background: rgba(10, 10, 25, 0.6);
        transition: all 0.3s ease;
    }

    .users-table tbody tr:hover {
        background: rgba(255, 94, 0, 0.15);
        transform: translateX(5px);
    }

    .users-table tbody tr.active-user {
        border-left: 3px solid #00FF88;
    }

    .users-table tbody tr.inactive-user {
        border-left: 3px solid rgba(255, 94, 0, 0.6);
    }

    .users-table td {
        padding: 1rem;
        color: rgba(255, 255, 255, 0.9);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1rem;
    }

    .user-email {
        font-weight: 600;
    }

    .username {
        color: rgba(255, 255, 255, 0.8);
    }

    .badge-active {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(0, 255, 136, 0.2), rgba(0, 255, 136, 0.1));
        border: 1px solid #00FF88;
        border-radius: 20px;
        color: #00FF88;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .badge-inactive {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(255, 94, 0, 0.2), rgba(255, 94, 0, 0.1));
        border: 1px solid #FF5E00;
        border-radius: 20px;
        color: #FF5E00;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .badge-none {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: rgba(128, 128, 128, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .date-info {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.95rem;
    }

    .stripe-id {
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #00B2FF;
        background: rgba(0, 178, 255, 0.1);
        padding: 0.25rem 0.5rem;
        border-radius: 5px;
        border: 1px solid rgba(0, 178, 255, 0.3);
    }

    .text-muted {
        color: rgba(255, 255, 255, 0.4) !important;
    }

    .alert-custom {
        background: rgba(255, 94, 0, 0.1);
        border: 2px solid rgba(255, 94, 0, 0.4);
        color: #FF5E00;
        padding: 1.5rem;
        border-radius: 10px;
        text-align: center;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1rem;
    }

    .alert-success-custom {
        background: rgba(0, 255, 136, 0.12);
        border: 2px solid rgba(0, 255, 136, 0.5);
        color: #00FF88;
        padding: 1.5rem;
        border-radius: 10px;
        text-align: center;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1rem;
    }

    .btn-secondary {
        background: linear-gradient(135deg, rgba(108, 117, 125, 0.8), rgba(73, 80, 87, 0.8));
        border: 2px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        padding: 0.75rem 1.5rem;
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background: linear-gradient(135deg, rgba(73, 80, 87, 0.9), rgba(52, 58, 64, 0.9));
        border-color: rgba(0, 178, 255, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(0, 178, 255, 0.3);
    }

    .btn-deactivate {
        background: linear-gradient(135deg, rgba(255, 94, 0, 0.9), rgba(255, 94, 0, 0.6));
        border: 1px solid rgba(255, 94, 0, 0.8);
        color: #fff;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .btn-deactivate:hover {
        background: linear-gradient(135deg, rgba(255, 94, 0, 1), rgba(255, 94, 0, 0.7));
        transform: translateY(-1px);
        box-shadow: 0 0 15px rgba(255, 94, 0, 0.4);
    }

    .btn-deactivate:disabled {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        color: rgba(255, 255, 255, 0.4);
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }

    @@media (max-width: 768px) {
        .stats-cards {
            grid-template-columns: 1fr;
        }

        .table-container {
            overflow-x: scroll;
        }

        .users-table {
            font-size: 0.85rem;
        }

        .users-table th,
        .users-table td {
            padding: 0.75rem 0.5rem;
        }
    }
</style>
