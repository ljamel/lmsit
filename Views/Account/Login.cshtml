@model LoginViewModel

@{
    ViewData["Title"] = "Se connecter";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                <h4>@ViewData["Title"]</h4>
                </div>
                <div class="contact-form">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-group">
                            <label for="name">Email</label><input asp-for="Email" class="form-control" id="email" name="email" required="">
                        </div>
                        <div class="form-group">
                            <label for="Password">Mot de passe</label><input asp-for="Password" class="form-control" id="password" name="Password" required="">
                        </div>
                        <div class="form-group text-end" style="margin-top: -10px; margin-bottom: 20px;">
                            <a asp-action="ForgotPassword" style="color: #FF5E00; font-size: 0.9rem; text-decoration: none;">Mot de passe oublié ?</a>
                        </div>
                        <button type="submit" class="submit-btn">Se connecter</button>
                    </form>
                </div>
            </div>
            <div class="card-footer">
                <p class="text-center mb-0">
                    Pas encore inscrit? <a asp-action="Register">S'inscrire</a>
                </p>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
