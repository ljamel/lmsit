@{
    ViewData["Title"] = "Définir Votre Mot de Passe";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #00B2FF 0%, #0080FF 100%); padding: 30px;">
                    <i class="fas fa-shield-alt" style="font-size: 3rem; margin-bottom: 15px;"></i>
                    <h3 class="mb-0">Sécurisez Votre Compte</h3>
                    <p class="mb-0 mt-2">Définissez votre mot de passe personnel</p>
                </div>
                <div class="card-body" style="padding: 40px;">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Votre compte est actif !</strong><br/>
                        Pour des raisons de sécurité, veuillez définir votre propre mot de passe avant d'accéder aux cours.
                    </div>

                    <form asp-action="SetPassword" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        
                        <div class="form-group mb-4">
                            <label for="newPassword" class="form-label fw-bold">
                                <i class="fas fa-lock me-2"></i>Nouveau Mot de Passe
                            </label>
                            <input 
                                type="password" 
                                name="newPassword" 
                                id="newPassword" 
                                class="form-control form-control-lg" 
                                placeholder="••••••••" 
                                required
                                style="border: 2px solid #00B2FF; border-radius: 10px; padding: 15px;"
                            />
                            <small class="form-text text-muted">Minimum 6 caractères</small>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label for="confirmPassword" class="form-label fw-bold">
                                <i class="fas fa-lock me-2"></i>Confirmer le Mot de Passe
                            </label>
                            <input 
                                type="password" 
                                name="confirmPassword" 
                                id="confirmPassword" 
                                class="form-control form-control-lg" 
                                placeholder="••••••••" 
                                required
                                style="border: 2px solid #00B2FF; border-radius: 10px; padding: 15px;"
                            />
                        </div>
                        
                        <button type="submit" class="btn btn-lg w-100" style="background: linear-gradient(135deg, #00B2FF 0%, #0080FF 100%); color: white; padding: 15px; border: none; border-radius: 10px; font-weight: bold; font-size: 1.2rem;">
                            <i class="fas fa-save me-2"></i>Définir Mon Mot de Passe
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">
                            <i class="fas fa-lock me-1"></i>
                            Vos données sont protégées et chiffrées
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        box-shadow: 0 10px 40px rgba(0, 178, 255, 0.2);
    }

    .form-control:focus {
        border-color: #0080FF;
        box-shadow: 0 0 0 0.2rem rgba(0, 178, 255, 0.25);
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(0, 178, 255, 0.4);
        transition: all 0.3s ease;
    }

    .password-requirements {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        border-left: 4px solid #00B2FF;
    }
</style>

@section Scripts {
    <script>
        // Validation en temps réel
        document.getElementById('confirmPassword').addEventListener('input', function() {
            var newPassword = document.getElementById('newPassword').value;
            var confirmPassword = this.value;
            
            if (confirmPassword && newPassword !== confirmPassword) {
                this.setCustomValidity('Les mots de passe ne correspondent pas');
                this.classList.add('is-invalid');
            } else {
                this.setCustomValidity('');
                this.classList.remove('is-invalid');
            }
        });
    </script>
}
